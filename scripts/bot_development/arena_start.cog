# Adjoin Arena. Per-seat opening on stock starts, followed by ordinary respawns.
flags=0x240

symbols
message startup
message newplayer
message pulse
thing player                         local
int slot=-1                          local
int savedMask=0                      local
int opening=0                        local
int rifle=-1                         local
int sample=0                         local
end

code
startup:
   player = GetLocalPlayerThing();
   slot = GetPlayerNum(player);
   if ((slot != 1) && (slot != 2)) return;
   savedMask = GetRespawnMask(player);
   if (slot == 1) SetRespawnMask(player, 0xFFFFFFFD);
   else SetRespawnMask(player, 0xFFFFFBFF);
   opening = 1;
   return;

newplayer:
   if ((slot != 1) && (slot != 2)) return;
   if (GetSenderRef() != player) return;
   if (opening == 1)
   {
      opening = 0;
      SetRespawnMask(player, savedMask);
      Print("ADJOIN_OPENING");
      PrintInt(slot);
      PrintInt(GetThingSector(player));
      PrintVector(GetThingPos(player));
      PrintInt(savedMask);
      PrintInt(GetRespawnMask(player));
      SetPulse(0.1);
   }
   else
   {
      Print("ADJOIN_RESPAWN");
      PrintInt(slot);
      PrintInt(GetThingSector(player));
      PrintVector(GetThingPos(player));
      PrintInt(GetRespawnMask(player));
   }
   rifle = GetInv(player, 9);
   Print("ADJOIN_RIFLE_BASE");
   PrintInt(rifle);
   return;

pulse:
   sample = GetInv(player, 9);
   if (sample != rifle)
   {
      Print("ADJOIN_RIFLE_CHANGE");
      PrintInt(rifle);
      PrintInt(sample);
      PrintFlex(GetLevelTime());
      rifle = sample;
   }
   return;
end
