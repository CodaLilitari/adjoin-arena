+        jkBotLoadout plan;
+        if (jkBotLoadout_Plan(8,side && !strcmp(side,"dark"),jkBotLoadout_Style(style),&plan)) {
+            for (int bin=SITHBIN_F_JUMP;bin<=SITHBIN_F_DEADLYSIGHT;bin++) sithInventory_SetInventory(self,bin,plan.stars[bin]);
+            sithInventory_SetInventory(self,SITHBIN_JEDI_RANK,8);
+            jkPlayer_SetRank(8);
