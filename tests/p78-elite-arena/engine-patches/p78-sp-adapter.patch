+    if (!jkBotP78_sp || !t || t->type!=SITH_THING_ACTOR) return -1;
+    for (int k=0;k<4;k++) if (jkBotP78_body[k]==(int)t->idx) return jkBotP78_cw[k]>=1 && jkBotP78_cw[k]<=10 ? jkBotP78_cw[k] : -1;
+    return -1;
+}
+#define BOT_PEER_TYPE(t) ((t)->type==SITH_THING_PLAYER || (jkBotP78_sp && (t)->type==SITH_THING_ACTOR))
