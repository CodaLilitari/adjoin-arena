+    jkBotP78_infos[0]=*sithPlayer_g_pLocalPlayer;
+    jkBotP78_infos[0].flags|=1;
+    if (!jkBotP78_infos[0].playerNetId) jkBotP78_infos[0].playerNetId=1;
+    if (w!=jkBotP78_world) { jkBotP78_world=w; jkBotP78_nextQuery=0; for (int k=0;k<4;k++) jkBotP78_body[k]=-1; }
+    if (now>=jkBotP78_nextQuery || now<jkBotP78_nextQuery-1.0) {
+        jkBotP78_nextQuery=now+0.25;
+        for (int k=0;k<4;k++) {
+            jkBotP78_body[k]=jkBotP78_Query(11,k);
+            jkBotP78_cw[k]=-1;
+            if (jkBotP78_body[k]>=0 && sithWorld_g_pStaticWorld && sithWorld_g_pStaticWorld->numCogs>(uint32_t)(37+k))
+                jkBotP78_cw[k]=(int)sithCog_SendMessageEx(&sithWorld_g_pStaticWorld->aCogs[37+k],SITH_MESSAGE_USER2,
+                    SENDERTYPE_SYSTEM,0,0,0,0,0,0,0,0);
+        }
+    }
+    for (int k=0;k<4;k++) {
+        int idx=jkBotP78_body[k];
+        if (idx<0 || idx>=w->numThingsLoaded) continue;
+        SithThing *t=&w->aThings[idx];
+        if (t->type!=SITH_THING_ACTOR || !t->sector) continue;
+        SithPlayer *s=&jkBotP78_infos[1+k];
+        s->pLocalPlayer=t; s->flags=1; s->playerNetId=1001+k; s->teamNum=0;
+        if (jkBotP78_max<(uint32_t)(2+k)) jkBotP78_max=2+k;
+    }
+}
+/* The gun a P78 bot holds, from its arms COG (it has no playerInfo weapon mesh); -1 unknown. */
+static int jkBotP78_Weapon(const SithThing *t)
