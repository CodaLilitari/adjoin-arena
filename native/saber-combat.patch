+/* Check a visible mesh opponent at saber range with the stock world query.
+   Face colliders can have empty space at the thing origin; sphere colliders
+   have their hit volume centered on that origin regardless of skin. */
+static int Bot_SaberSeesBand(SithThing *self,SithThing *target,rdVector3 point,flex_t radius)
+{
+    rdVector3 dir=Bot_Sub(point,self->position);
+    flex_t len=Bot_Len(dir);
+    if (len<0.001f || !self->sector) return 0;
+    dir.x/=len; dir.y/=len; dir.z/=len;
+    sithCollision_SearchForCollisions(self->sector,self,&self->position,&dir,len+radius,0,0);
+    SithCollision *hit;
+    do { hit=sithCollision_PopStack(); } while (hit && (hit->type&SITHCOLLISION_ADJOINCROSS));
+    int visible=hit && (hit->type&SITHCOLLISION_THING) && hit->pThingCollided==target;
+    sithCollision_DecreaseStackLevel();
+    return visible;
+}
+
+static rdVector3 Bot_SaberAimPoint(SithThing *self,SithThing *target)
+{
+    rdVector3 aim=target->position;
+    flex_t radius=target->collideSize;
+    if (target->collide==SITH_COLLIDE_SPHERE_TREE) radius=target->treeSize;
+    if (!isfinite(radius) || radius<=0) return aim;
+    if ((target->collide==SITH_COLLIDE_FACE || target->collide==SITH_COLLIDE_SPHERE_TREE) &&
+        target->renderData.model3 && Bot_Distance(self->position,aim)<0.75f &&
+        !Bot_SaberSeesBand(self,target,aim,radius)) {
+        static const flex_t heights[]={-0.45f,0.45f,-0.85f,0.85f};
+        for (unsigned i=0;i<sizeof(heights)/sizeof(*heights);i++) {
+            rdVector3 point=aim; point.z+=radius*heights[i];
+            if (Bot_SaberSeesBand(self,target,point,radius)) { aim=point; break; }
+        }
+    }
+    /* Lead at most one body radius and at most 0.08 world units. Estimate
+       relative rise/fall over the next 80 ms, including our own jump. */
+    flex_t vz=target->physicsParams.vel.z-self->physicsParams.vel.z;
+    flex_t bound=Bot_Min(radius,0.08f);
+    if (isfinite(vz)) aim.z+=Bot_Clamp(vz*0.08f,-bound,bound);
+    return aim;
+}
+
