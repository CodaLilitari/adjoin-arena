+/* Bot_Recovery handles a bot that cannot move. This handles one that moves
+   and still goes nowhere: failed water exits, a jump that keeps missing, two
+   goals that undo each other. Positions are sampled across the window; if
+   every sample lies within the radius of their centre while the bot is not
+   waiting for something or fighting on dry ground, the bot is confined.
+   Each escape gives up the current goal and avoids the places being tried.
+   Repeats within 45 seconds double the avoid time and widen it to nearby
+   places, so the next plan must lead somewhere else. In water the bot also
+   takes the existing air-and-bank escape and remembers the dive as failed.
+   A hold shorter than two seconds only pauses the sampling, so a bot bobbing
+   between a bank and the water, or glimpsing an opponent, is still caught. */
+static int Bot_HoldingPosition(SithThing *self)
+{
+    if (!bot.graphDone || bot.nNodes<1 || (self->actorParams.flags&SITH_AF_IMMOBILE)) return 1;
+    if (nav.waitUntil>bot.now || nav.liftWaitAt>0 || nav.crossingEntry) return 1;
+    if (nav.objectiveValid && (nav.objective==BOT_OBJECTIVE_DEFEND || nav.objective==BOT_OBJECTIVE_ESCORT)) return 1;
+    if (self->sector->flags&SITH_SECTOR_UNDERWATER) return 0;
+    /* On dry ground a fight may stay put, and a bot the planner gave no
+       destination has nothing to escape from. This runs after the planner. */
+    return bot.targetSlot>=0 || (bot.goal<0 && !bot.armItem && !nav.diveEscape);
+}
+
+static void Bot_Avoid(int node,flex_t until)
+{
+    if (node>=0 && node<bot.nNodes && bot.nodes[node].avoidUntil<until) bot.nodes[node].avoidUntil=until;
+}
+
+static void Bot_Confinement(SithThing *self)
+{
+    flex_t window=BT(CONFINE_SECONDS), radius=BT(CONFINE_RADIUS);
+    if (window<=0) { bot.confine.count=bot.confine.next=0; return; }
+    if (Bot_HoldingPosition(self)) {
+        if (!bot.confine.holding) { bot.confine.holding=1; bot.confine.holdReset=bot.now+2.0f; }
+        else if (bot.now>=bot.confine.holdReset) bot.confine.count=bot.confine.next=0;
+        return;
+    }
+    bot.confine.holding=0;
+    if (bot.now<bot.confine.nextSample) return;
+    bot.confine.nextSample=bot.now+window/BOT_CONFINE_SAMPLES;
+    bot.confine.at[bot.confine.next]=self->position;
+    bot.confine.next=(bot.confine.next+1)%BOT_CONFINE_SAMPLES;
+    if (bot.confine.count<BOT_CONFINE_SAMPLES && ++bot.confine.count<BOT_CONFINE_SAMPLES) return;
+    rdVector3 centre={0,0,0};
+    for (int i=0;i<BOT_CONFINE_SAMPLES;i++) {
+        centre.x+=bot.confine.at[i].x; centre.y+=bot.confine.at[i].y; centre.z+=bot.confine.at[i].z;
+    }
+    centre.x/=BOT_CONFINE_SAMPLES; centre.y/=BOT_CONFINE_SAMPLES; centre.z/=BOT_CONFINE_SAMPLES;
+    for (int i=0;i<BOT_CONFINE_SAMPLES;i++)
+        if (Bot_Distance(bot.confine.at[i],centre)>radius) return;
+    if (bot.confine.strikes && bot.now-bot.confine.lastStrike>45.0f) bot.confine.strikes=0;
+    if (bot.confine.strikes<5) bot.confine.strikes++;
+    bot.confine.lastStrike=bot.now; bot.confine.count=bot.confine.next=0;
+    int strikes=bot.confine.strikes;
+    int wet=(self->sector->flags&SITH_SECTOR_UNDERWATER) || (self->physicsParams.flags&SITH_PF_ONWATERSURFACE);
+    flex_t tabu=Bot_Min(120.0f,BT(TABU_SECONDS)*(flex_t)(1<<(strikes-1)));
+    flex_t reach=strikes<2 ? 0.0f : strikes<3 ? 0.75f : 1.5f, until=bot.now+tabu;
+    int node=bot.routePos<bot.routeCount ? bot.route[bot.routePos] : -1, goal=bot.goal;
+    Bot_Avoid(node,until); Bot_Avoid(goal,until);
+    if (nav.waterExitUntil>0) Bot_Avoid(nav.waterExitTo,until);
+    if (bot.armItem && !bot.armDirect) Bot_Avoid(bot.armNode-1,until);
+    for (int i=0;reach>0 && i<bot.nNodes;i++)
+        if (Bot_Distance(bot.nodes[i].pos,self->position)<=reach) Bot_Avoid(i,until);
+    fprintf(stderr,"BOT_CONFINED name=%s t=%.2f sector=%u pos=%.3f,%.3f,%.3f wet=%d strikes=%d tabu=%.1f reach=%.2f node=%d goal=%d\n",
+        bot.name,(double)bot.now,self->sector->id,(double)self->position.x,(double)self->position.y,
+        (double)self->position.z,wet,strikes,(double)tabu,(double)reach,node,goal);
+    fflush(stderr);
+    if (wet) {
+        SithThing *item=Bot_NavThing(bot.armItem-1);
+        if (Bot_WetSupply(self,item) && item->guid==bot.armGuid && item->signature==bot.armSignature) {
+            Bot_RememberFailedApproach();
+            Bot_RememberFailedDive();
+        }
+        nav.diveEscape=BOT_DIVE_AIR;
+    }
+    nav.waterExitUntil=0; nav.seekingSurface=0; nav.jumpUntil=0;
+    if (nav.forceJumpPending) {
+        if (bot.forceBin==SITHBIN_F_JUMP) bot.forceUntil=bot.now;
+        nav.forceJumpPending=0;
+    }
+    Bot_ClearEquipment("confined");
+    bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0; bot.nextRecovery=0;
+    bot.stuckAt=bot.now; bot.routeStallTime=0;
+}
