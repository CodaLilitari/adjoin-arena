+/* Turning back for air before reaching the destination means that way into
+   the water did not pay. Remember the entry so the planner prices it out,
+   and set the destination aside, for dive_retry seconds. A bot that already
+   has what it came for is on its way out and is left alone. */
+static void Bot_CheckAirReturn(SithThing *self)
+{
+    if (!(self->sector->flags&SITH_SECTOR_UNDERWATER)) {
+        if (bot.tele.wasWet) bot.entryFrom=bot.entryTo=bot.crossing=0; /* out again: that entry is spent */
+        if (bot.crossing && bot.now-bot.crossingAt>2.0f) bot.crossing=0; /* never went in */
+        bot.airReturn=0;
+        return;
+    }
+    if (bot.airReturn || BT(DIVE_RETRY)<=0 || !Bot_NeedsAir(self)) return;
+    bot.airReturn=1;
+    if (nav.diveEscape) return;
+    int known=bot.entryFrom>0 && bot.entryTo>0 && bot.entryFrom<=bot.nNodes && bot.entryTo<=bot.nNodes;
+    if (known) Bot_RememberCrossing(bot.nodes[bot.entryFrom-1].sector,bot.nodes[bot.entryTo-1].sector);
+    if (bot.goal>=0 && bot.goal<bot.nNodes && bot.nodes[bot.goal].avoidUntil<bot.now+BT(DIVE_RETRY))
+        bot.nodes[bot.goal].avoidUntil=bot.now+BT(DIVE_RETRY);
+    fprintf(stderr,"BOT_WATER name=%s t=%.2f event=air-return entry=%d goal=%d gear=%d seconds=%.1f\n",
+        bot.name,(double)bot.now,known,bot.goal,bot.armItem-1,(double)(nav.waterSince>0 ? bot.now-nav.waterSince : 0));
+    Bot_ClearEquipment("air-return");
+    bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+}
