diff --git a/src/AI/jkBotTactics.inc b/src/AI/jkBotTactics.inc
new file mode 100644
index 0000000..6d9c502
--- /dev/null
+++ b/src/AI/jkBotTactics.inc
@@ -0,0 +1,220 @@
+/* Named, bounded tactic values for the ordinary-input bot; see jkBot.c for license.
+ *
+ * A tactic is a number the planner or the movement code reads on every
+ * decision. Nothing here writes game state: a tactic only changes which
+ * ordinary inputs the bot chooses. Values come from three places, in order:
+ *
+ *   1. the compiled defaults below;
+ *   2. JK_BOT_TACTICS_FILE, a complete "name=value" revision that replaces
+ *      the defaults whenever its content changes (the operator's baseline);
+ *   3. the companion TACTICS command, which merges a few values into the
+ *      current table (the coach's live adjustment).
+ *
+ * A live adjustment is refused for BOT_TACTICS_COMMIT_SECONDS after the
+ * previous one, so no controller can flip the bot between plans faster than
+ * a plan can show whether it works.
+ *
+ * The wire identifies a tactic by its position in this table. Append new
+ * rows at the end; never reorder or delete a row. bots/tactics.py mirrors
+ * the table and tests/test_bot_tactics.py checks the two against each other.
+ *
+ * Columns: identifier, file name, default, legacy, lowest, highest.
+ * "legacy" is the value that reproduces the behaviour before this table
+ * existed, so a trial can compare the two without a rebuild.
+ */
+#define BOT_TACTIC_TABLE(X) \
+    /* Planner: what a missing gun is worth while healthy (elite bots). */ \
+    X(VALUE_CONC,       "value_conc",       18.0f, 18.0f, 0.0f,  40.0f) \
+    X(VALUE_RAIL,       "value_rail",       12.0f, 12.0f, 0.0f,  40.0f) \
+    X(VALUE_REPEATER,   "value_repeater",   10.0f, 10.0f, 0.0f,  40.0f) \
+    X(VALUE_WEAPON,     "value_weapon",      8.0f,  8.0f, 0.0f,  40.0f) \
+    /* Planner: weight of unvisited places, and the share of it that an \
+       underwater place keeps. 0 means the bot never dives just to look. */ \
+    X(EXPLORE,          "explore",           2.4f,  2.4f, 0.0f,  10.0f) \
+    X(EXPLORE_WET,      "explore_wet",       0.0f,  1.0f, 0.0f,   1.0f) \
+    /* Planner: how fast a goal loses appeal with path length, the appeal \
+       of hunting a living opponent, and seconds a chosen goal is kept. */ \
+    X(TRAVEL_COST,      "travel_cost",      0.42f, 0.42f, 0.05f,  2.0f) \
+    X(PURSUIT,          "pursuit",           9.0f,  9.0f, 0.0f,  40.0f) \
+    X(GOAL_HOLD,        "goal_hold",        14.0f, 14.0f, 2.0f,  60.0f) \
+    /* Water: extra path cost of stepping into water, the least a submerged \
+       pickup must be worth to dive for, and seconds underwater before the \
+       bot heads for air regardless of breath. */ \
+    X(WATER_ENTRY_COST, "water_entry_cost",  4.0f,  0.0f, 0.0f,  40.0f) \
+    X(DIVE_MIN_VALUE,   "dive_min_value",    6.0f,  0.0f, 0.0f,  40.0f) \
+    X(DIVE_SECONDS,     "dive_seconds",      8.0f,  8.0f, 2.0f,  30.0f) \
+    /* Movement: hold the ordinary run key on checked open ground; stop \
+       running this far before a jump, drop, lift, water edge or corner. */ \
+    X(RUN,              "run",               1.0f,  0.0f, 0.0f,   1.0f) \
+    X(RUN_BRAKE,        "run_brake",         0.8f,  0.8f, 0.2f,   3.0f) \
+    /* Movement: aim the thrust exactly along the wanted direction, and use \
+       the forward-plus-strafe diagonal on straight runs at least this long. */ \
+    X(EXACT_THRUST,     "exact_thrust",      1.0f,  0.0f, 0.0f,   1.0f) \
+    X(STRAFE_RUN,       "strafe_run",        1.0f,  0.0f, 0.0f,   1.0f) \
+    X(STRAFE_MIN_LEG,   "strafe_min_leg",    1.0f,  1.0f, 0.3f,  10.0f) \
+    /* Recovery: staying inside this radius for this long, while not \
+       waiting or fighting on dry ground, counts as confined (0 seconds \
+       turns the check off). The first escape avoids the failing places \
+       for tabu_seconds; each repeat doubles it and widens the area. */ \
+    X(CONFINE_RADIUS,   "confine_radius",   0.35f, 0.35f, 0.1f,   2.0f) \
+    X(CONFINE_SECONDS,  "confine_seconds",   6.0f,  0.0f, 0.0f,  60.0f) \
+    X(TABU_SECONDS,     "tabu_seconds",     12.0f, 12.0f, 1.0f, 120.0f) \
+    /* Combat: sideways share of gunfight movement, and the band of range \
+       a gunner holds (advance beyond far, back off inside near). */ \
+    X(COMBAT_STRAFE,    "combat_strafe",    0.55f, 0.55f, 0.0f,   1.0f) \
+    X(GUN_FAR,          "gun_far",           2.5f,  2.5f, 0.3f,  20.0f) \
+    X(GUN_NEAR,         "gun_near",         0.75f, 0.75f, 0.0f,  10.0f)
+
+enum {
+#define X(id,name,initial,legacy,low,high) BT_##id,
+    BOT_TACTIC_TABLE(X)
+#undef X
+    BT_COUNT
+};
+enum { BOT_TACTICS_COMMIT_SECONDS = 8, BOT_TACTICS_WIRE_PAIRS = 21 };
+
+typedef struct BotTacticSpec { const char *name; float initial, legacy, low, high; } BotTacticSpec;
+static const BotTacticSpec botTacticSpecs[BT_COUNT]={
+#define X(id,name,initial,legacy,low,high) {name,initial,legacy,low,high},
+    BOT_TACTIC_TABLE(X)
+#undef X
+};
+
+/* Existing regression suites pin the behaviour they were written against. */
+#ifdef JKBOT_TACTICS_BASELINE_LEGACY
+#define BOT_TACTIC_BASELINE(initial,legacy) legacy
+#else
+#define BOT_TACTIC_BASELINE(initial,legacy) initial
+#endif
+
+static struct {
+    float value[BT_COUNT];
+    char file[4096];
+    flex_t nextFile, lockedUntil;
+    uint32_t fileHash, revision;
+    int fileSeen;
+} tactics={.value={
+#define X(id,name,initial,legacy,low,high) BOT_TACTIC_BASELINE(initial,legacy),
+    BOT_TACTIC_TABLE(X)
+#undef X
+}};
+#define BT(id) (tactics.value[BT_##id])
+#define BT_ON(id) (tactics.value[BT_##id]>=0.5f)
+
+static void Bot_TacticsBaseline(float *values,int legacy)
+{
+    for (int i=0;i<BT_COUNT;i++)
+        values[i]=legacy ? botTacticSpecs[i].legacy :
+            BOT_TACTIC_BASELINE(botTacticSpecs[i].initial,botTacticSpecs[i].legacy);
+}
+
+static int Bot_TacticValid(int id,float value)
+{
+    return id>=0 && id<BT_COUNT && isfinite(value) &&
+        value>=botTacticSpecs[id].low && value<=botTacticSpecs[id].high;
+}
+
+/* A new table takes effect at the next decision. The current goal is kept:
+   goal_hold and the route follower decide when to let go of it. */
+static void Bot_TacticsApply(const float *values,const char *source)
+{
+    int changed=0;
+    for (int i=0;i<BT_COUNT;i++) if (tactics.value[i]!=values[i]) changed++;
+    memcpy(tactics.value,values,sizeof(tactics.value));
+    tactics.revision++;
+    bot.nextPlan=bot.armNext=0;
+    fprintf(stderr,"BOT_TACTICS name=%s t=%.2f source=%s revision=%u changed=%d\n",
+        bot.name,(double)bot.now,source,tactics.revision,changed);
+    fflush(stderr);
+}
+
+/* The operator atomically replaces this complete file. Unknown names,
+   repeated names and out-of-range values reject the whole revision. */
+static int Bot_ReadTactics(const char *text,size_t length,float *values)
+{
+    unsigned char seen[BT_COUNT]={0};
+    int version=0,rows=0;
+    Bot_TacticsBaseline(values,0);
+    for (size_t at=0;at<length;) {
+        char row[96];
+        size_t end=at;
+        while (end<length && text[end]!='\n') end++;
+        size_t n=end-at;
+        if (n && text[at+n-1]=='\r') n--;
+        if (n>=sizeof(row) || ++rows>BT_COUNT+8) return 0;
+        memcpy(row,text+at,n); row[n]=0;
+        at=end<length ? end+1 : end;
+        if (!n || row[0]=='#') continue;
+        char *eq=strchr(row,'='),*stop;
+        if (!eq || eq==row || !eq[1]) return 0;
+        *eq++=0;
+        if (!strcmp(row,"version")) {
+            if (version || strcmp(eq,"1")) return 0;
+            version=1; continue;
+        }
+        int id=-1;
+        for (int i=0;i<BT_COUNT;i++) if (!strcmp(row,botTacticSpecs[i].name)) { id=i; break; }
+        if (id<0 || seen[id]) return 0;
+        for (const char *c=eq;*c;c++)
+            if (!((*c>='0' && *c<='9') || *c=='.' || *c=='-')) return 0;
+        float value=strtof(eq,&stop);
+        if (*stop || !Bot_TacticValid(id,value)) return 0;
+        values[id]=value; seen[id]=1;
+    }
+    return version;
+}
+
+static void Bot_ReloadTactics(void)
+{
+    tactics.nextFile=bot.now+1.0f;
+    if (!*tactics.file) return;
+    FILE *f=fopen(tactics.file,"rb"); if (!f) return;
+    char text[4097];
+    size_t length=fread(text,1,sizeof(text),f);
+    int failed=ferror(f); fclose(f);
+    if (failed || !length) return;
+    uint32_t hash=2166136261u;
+    for (size_t i=0;i<length;i++) hash=(hash^(unsigned char)text[i])*16777619u;
+    if (tactics.fileSeen && hash==tactics.fileHash) return;
+    tactics.fileSeen=1; tactics.fileHash=hash;
+    float values[BT_COUNT];
+    if (length>=sizeof(text) || !Bot_ReadTactics(text,length,values)) {
+        fprintf(stderr,"BOT_TACTICS name=%s t=%.2f source=file status=rejected\n",bot.name,(double)bot.now);
+        fflush(stderr);
+        return;
+    }
+    Bot_TacticsApply(values,"file");
+}
+
+static void Bot_ConfigureTactics(void)
+{
+    memset(&tactics,0,sizeof(tactics));
+    Bot_TacticsBaseline(tactics.value,0);
+    const char *path=getenv("JK_BOT_TACTICS_FILE");
+    if (path && strlen(path)<sizeof(tactics.file)) strcpy(tactics.file,path);
+}
+
+/* Companion payload after the 8-byte deadline: flags, count, then count
+   records of one identifier byte and one little-endian float. Flag bit 0
+   restores the compiled defaults before the records are merged. Returns 0
+   when applied, 1 for a malformed or out-of-range request, 2 while the
+   previous adjustment is still committed. Nothing is applied on failure. */
+static int Bot_WireTactics(const unsigned char *p,int size)
+{
+    if (size<2 || (p[0]&~1) || p[1]>BOT_TACTICS_WIRE_PAIRS || size!=2+5*p[1] || (!p[1] && !(p[0]&1))) return 1;
+    float values[BT_COUNT];
+    unsigned char seen[BT_COUNT]={0};
+    if (p[0]&1) Bot_TacticsBaseline(values,0);
+    else memcpy(values,tactics.value,sizeof(values));
+    for (int i=0;i<p[1];i++) {
+        const unsigned char *record=p+2+5*i;
+        uint32_t bits=record[1]|((uint32_t)record[2]<<8)|((uint32_t)record[3]<<16)|((uint32_t)record[4]<<24);
+        float value; memcpy(&value,&bits,4);
+        if (!Bot_TacticValid(record[0],value) || seen[record[0]]) return 1;
+        seen[record[0]]=1; values[record[0]]=value;
+    }
+    if (bot.now<tactics.lockedUntil) return 2;
+    tactics.lockedUntil=bot.now+BOT_TACTICS_COMMIT_SECONDS;
+    Bot_TacticsApply(values,"companion");
+    return 0;
+}
