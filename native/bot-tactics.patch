@@ -0,0 +1,515 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+/* Running jumps: a jump released at running speed keeps that speed through
+   the air (the stock Force Jump script adds its upward velocity to the
+   player's own). With Force Speed this crosses gaps no standing jump can.
+   Ordinary inputs only: the run key, the movement axes, the jump key and the
+   two stock Force keys. */
+
+static flex_t Bot_ForceCost(SithThing *self,int bin);
+static int Bot_NavDirectMove(SithThing *self, rdVector3 target, int swim);
+
+/* Why candidates were dropped, for the ready line: detour too short, no
+   launch that lands, no runway, flight blocked. */
+static int runJumpDropped[4];
+
+static flex_t RunJump_Drag(SithThing *self)
+{ return self->physicsParams.surfDrag>0.5f ? self->physicsParams.surfDrag : 3.0f; }
+
+static flex_t RunJump_Boost(int rank) { return rank>0 ? 0.5f+0.5f*rank : 0.0f; }
+
+/* Free flight from ground speed v and upward speed vz, forward held: where
+   and how fast the body comes back down to height dz. */
+static int RunJump_Flight(SithThing *self,flex_t v,flex_t vz,flex_t thrust,flex_t dz,
+                          flex_t *reach,flex_t *sink,flex_t *seconds)
+{
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag, gravity=bot.world->gravity;
+    flex_t x=0,z=0,push=0,next=0,peak=0;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; v=v*decay+push*dt; vz=vz*decay-gravity*dt;
+        x+=v*dt; z+=vz*dt; if (z>peak) peak=z;
+        if (vz<0 && z<=dz) {
+            /* A higher landing must first have been cleared. */
+            if (dz>0 && peak<dz+0.02f) return 0;
+            *reach=x; *sink=-vz; *seconds=(i+1)*dt; return 1;
+        }
+    }
+    return 0;
+}
+
+/* The upward speed that lands a launch at speed v on the far node. A plain
+   jump has one; a Force Jump is held between .15 s and the rank's limit. */
+static int RunJump_Lift(SithThing *self,flex_t v,flex_t thrust,flex_t distance,flex_t dz,int jumpRank,
+                        int *force,flex_t *hold,flex_t *seconds)
+{
+    /* A landing faster than 2.5 hurts; up to 2.95 costs under ten health. */
+    const flex_t tolerance=0.22f,hurts=2.95f;
+    flex_t reach,sink,plain=self->actorParams.jumpSpeed;
+    if (plain>0.5f && RunJump_Flight(self,v,plain,thrust,dz,&reach,&sink,seconds) &&
+        fabsf(reach-distance)<=tolerance && sink<=hurts) { *force=0; *hold=0; return 1; }
+    if (jumpRank<1) return 0;
+    /* A hold too short to clear a higher ledge counts as falling short. */
+    flex_t low=0.15f,high=Bot_Min(0.35f*jumpRank,1.35f),best=low;
+    if (!RunJump_Flight(self,v,2.5f+low,thrust,dz,&reach,&sink,seconds)) reach=-1;
+    if (reach>distance+tolerance) return 0;
+    if (reach<distance) {
+        flex_t far;
+        if (!RunJump_Flight(self,v,2.5f+high,thrust,dz,&far,&sink,seconds) || far<distance-tolerance) return 0;
+        best=high;
+        if (far>distance) {
+            for (int i=0;i<14;i++) {
+                flex_t mid=0.5f*(low+high);
+                if (!RunJump_Flight(self,v,2.5f+mid,thrust,dz,&reach,&sink,seconds) || reach<distance) low=mid; else high=mid;
+            }
+            best=high;
+        }
+    }
+    if (!RunJump_Flight(self,v,2.5f+best,thrust,dz,&reach,&sink,seconds) || sink>hurts ||
+        fabsf(reach-distance)>tolerance) return 0;
+    *force=1; *hold=best; return 1;
+}
+
+/* One swept flight with level geometry: clear air, a foothold at the far
+   node's height within walking reach of it, and room to stop that ends in
+   floor or a wall, not in another edge. */
+static int RunJump_Sweep(SithThing *self,const BotNode *a,BotNode *b,flex_t v,flex_t vz,flex_t thrust)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta),radius=self->moveSize;
+    rdVector3 direction={delta.x/length,delta.y/length,0};
+    const int unsafe=SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag;
+    flex_t contact=b->pos.z-BOT_FOOT_HEIGHT+radius+0.002f,along=0,push=0,next=0;
+    rdVector3 pos=a->pos,swept=pos; SithSector *sector=a->sector;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; v=v*decay+push*dt; vz=vz*decay-bot.world->gravity*dt;
+        int lands=vz<0 && pos.z+dt*vz<=contact;
+        if (lands && pos.z<=contact && along<0.5f*length) return 0;
+        flex_t step=lands && vz<0 ? Bot_Clamp((contact-pos.z)/vz,0.0f,dt) : dt;
+        along+=v*step;
+        pos.x=a->pos.x+along*direction.x; pos.y=a->pos.y+along*direction.y; pos.z+=vz*step;
+        if (!lands && i%3!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,radius)) return 0;
+        swept=pos; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&unsafe)) return 0;
+        if (!lands) continue;
+        rdVector3 standing; SithSector *floor=NULL;
+        if (!Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.04f,&standing,&floor) ||
+            fabsf(standing.z-b->pos.z)>0.05f || fabsf(length-along)>0.5f) return 0;
+        BotNode foothold={.pos=standing,.sector=floor}; int drop=0;
+        if (Bot_Horizontal(Bot_Sub(b->pos,standing))>0.02f &&
+            (!Bot_WalkableSpan(&foothold,b,&drop,0.001f) || drop)) return 0;
+        /* Coasting to rest after the landing. */
+        flex_t coast=v/RunJump_Drag(self)+0.15f;
+        rdVector3 at=standing; SithSector *under=floor;
+        for (flex_t done=0;done<coast;done+=0.08f) {
+            rdVector3 ahead=at; ahead.x+=0.08f*direction.x; ahead.y+=0.08f*direction.y;
+            if (!Bot_Clear(NULL,under,at,ahead,radius,1)) break;
+            rdVector3 rest; SithSector *support=NULL;
+            under=Bot_SectorAt(&ahead,under);
+            if (!Bot_SectorSafe(under) || (under->flags&unsafe) ||
+                !Bot_Floor(ahead,under,BOT_FOOT_HEIGHT+0.06f,&rest,&support)) return 0;
+            at=rest;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* The run-up: level, walkable, straight behind the launch node. */
+static int RunJump_Runway(const BotNode *a,rdVector3 direction,flex_t length)
+{
+    rdVector3 start=a->pos,floor; SithSector *support=NULL;
+    start.x-=length*direction.x; start.y-=length*direction.y;
+    SithSector *sector=Bot_SectorAt(&start,a->sector);
+    if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST)) ||
+        !Bot_Floor(start,sector,BOT_FOOT_HEIGHT+0.05f,&floor,&support) || fabsf(floor.z-a->pos.z)>0.05f) return 0;
+    BotNode from={.pos=floor,.sector=support}; int drop=0;
+    return Bot_WalkableSpan(&from,(BotNode *)a,&drop,0.001f) && !drop;
+}
+
+/* Sprinting from rest with the run key: the speed reached after a given
+   distance, and how long that takes. Ground speed follows thrust over drag. */
+static void RunJump_Sprint(SithThing *self,flex_t thrust,flex_t length,flex_t *speed,flex_t *seconds)
+{
+    flex_t drag=RunJump_Drag(self),top=2.0f*thrust/drag,low=0,high=6.0f;
+    for (int i=0;i<24;i++) {
+        flex_t mid=0.5f*(low+high);
+        if (top*(mid-(1.0f-expf(-drag*mid))/drag)<length) low=mid; else high=mid;
+    }
+    *seconds=high; *speed=top*(1.0f-expf(-drag*high));
+}
+
+static int Bot_RunJumpSolve(SithThing *self,const BotNode *a,BotNode *b,int speedRank,int jumpRank,BotRunJump *plan)
+{
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) || !(bot.world->gravity>0) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) || !(self->actorParams.maxThrust>0)) return 0;
+    const int unsafe=SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    if (!Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) || ((a->sector->flags|b->sector->flags)&unsafe)) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    if (!(distance>=1.3f && distance<=4.6f) || fabsf(delta.z)>1.2f) return 0;
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    /* The run-up is whatever straight level floor lies behind the launch
+       node, up to the length that reaches full speed. */
+    flex_t room=0;
+    for (flex_t length=0.30f;length<=3.3f;length+=0.15f) { if (!RunJump_Runway(a,direction,length)) break; room=length; }
+    int stage=room>0 ? 1 : 0;
+    for (int sped=0;room>0 && sped<=(speedRank>0);sped++) for (int boost=0;boost<2;boost++) {
+        flex_t thrust=(self->actorParams.maxThrust+(sped ? RunJump_Boost(speedRank) : 0))*(boost ? BOT_DIAGONAL_GAIN : 1.0f);
+        flex_t runway=Bot_Min(room,0.85f*2.0f*thrust/RunJump_Drag(self)),speed,sprint,hold,seconds; int force;
+        RunJump_Sprint(self,thrust,runway,&speed,&sprint);
+        if (!RunJump_Lift(self,speed,thrust,distance,delta.z,jumpRank,&force,&hold,&seconds)) continue;
+        if (stage<2) stage=2;
+        /* A launch a little slow or fast must still find the foothold. */
+        flex_t vz=force ? 2.5f+hold : self->actorParams.jumpSpeed;
+        if (!RunJump_Sweep(self,a,b,speed,vz,thrust) || !RunJump_Sweep(self,a,b,0.94f*speed,vz,thrust) ||
+            !RunJump_Sweep(self,a,b,1.05f*speed,vz,thrust)) continue;
+        plan->speed=speed; plan->hold=hold; plan->runway=runway; plan->sprint=sprint; plan->seconds=seconds;
+        plan->boost=boost; plan->sped=sped; plan->force=force;
+        return 1;
+    }
+    runJumpDropped[1+stage]++;
+    return 0;
+}
+
+/* Running off a ledge into water below: the engine quarters the vertical
+   speed at the surface, so the landing costs nothing. From the launch node
+   the body keeps running to the lip, falls, and must be in water before it
+   can touch any floor. */
+static int RunJump_Dive(SithThing *self,const BotNode *a,const BotNode *b,flex_t speed,flex_t thrust,flex_t lip)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta),radius=self->moveSize;
+    rdVector3 direction={delta.x/length,delta.y/length,0};
+    const int unsafe=SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag;
+    /* The sphere is clear of the corner a little past the last foothold. */
+    flex_t along=lip+radius+0.04f,push=0,next=0,vz=0;
+    rdVector3 pos=a->pos; pos.x+=along*direction.x; pos.y+=along*direction.y;
+    SithSector *sector=Bot_SectorAt(&pos,a->sector);
+    rdVector3 swept=pos; flex_t top=pos.z;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; speed=speed*decay+push*dt; vz=vz*decay-bot.world->gravity*dt;
+        along+=speed*dt;
+        pos.x=a->pos.x+along*direction.x; pos.y=a->pos.y+along*direction.y; pos.z+=vz*dt;
+        if (i%3!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,radius)) return 0;
+        swept=pos; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&unsafe)) return 0;
+        if (!(sector->flags&SITH_SECTOR_UNDERWATER)) continue;
+        rdVector3 deeper=pos; deeper.z-=0.2f;
+        return top-pos.z>=0.8f && Bot_WaterClear(sector,pos,deeper,radius) &&
+               Bot_Distance(pos,b->pos)<=2.5f && Bot_WaterClear(sector,pos,b->pos,radius);
+    }
+    return 0;
+}
+
+static int Bot_RunDiveSolve(SithThing *self,const BotNode *a,BotNode *b,int speedRank,int sped,BotRunJump *plan)
+{
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) || !(bot.world->gravity>0) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) || !(self->actorParams.maxThrust>0) ||
+        !Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) ||
+        (a->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    if (!(distance>=0.3f && distance<=3.6f) || delta.z>-0.9f || delta.z<-9.0f) return 0;
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    /* Level floor from the node to the lip, and the run-up behind the node. */
+    rdVector3 pos=a->pos,floor; SithSector *sector=a->sector,*support=NULL; flex_t lip=0;
+    for (;;) {
+        rdVector3 ahead=pos; ahead.x+=0.04f*direction.x; ahead.y+=0.04f*direction.y;
+        if (!Bot_Clear(NULL,sector,pos,ahead,self->moveSize,1)) { runJumpDropped[2]++; return 0; }
+        pos=ahead; lip+=0.04f; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+        if (!Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.05f,&floor,&support)) break;
+        if (fabsf(floor.z-a->pos.z)>0.05f || lip>0.9f || lip>=distance) { runJumpDropped[2]++; return 0; }
+    }
+    flex_t room=0;
+    for (flex_t length=0.30f;length<=3.3f;length+=0.15f) { if (!RunJump_Runway(a,direction,length)) break; room=length; }
+    if (room<=0) { runJumpDropped[2]++; return 0; }
+    /* Slowest first: a walk, a run, a strafing run. Force Speed changes all
+       three, so each state of it is solved on its own. */
+    for (int pace=0;pace<3;pace++) {
+        flex_t thrust=(self->actorParams.maxThrust+(sped ? RunJump_Boost(speedRank) : 0))*(pace==2 ? BOT_DIAGONAL_GAIN : 1.0f);
+        flex_t ground=pace ? thrust : 0.5f*thrust;
+        flex_t runway=Bot_Min(room,0.85f*2.0f*ground/RunJump_Drag(self)),speed,sprint;
+        RunJump_Sprint(self,ground,runway+lip,&speed,&sprint);
+        if (!RunJump_Dive(self,a,b,speed,thrust,lip) || !RunJump_Dive(self,a,b,0.92f*speed,thrust,lip) ||
+            !RunJump_Dive(self,a,b,1.06f*speed,thrust,lip)) continue;
+        plan->speed=speed; plan->hold=0; plan->runway=runway; plan->sprint=sprint; plan->seconds=0;
+        plan->boost=pace==2; plan->sped=sped; plan->force=0; plan->dive=1; plan->walk=pace==0;
+        return 1;
+    }
+    runJumpDropped[3]++;
+    return 0;
+}
+
+/* A plan is solved for one speed. With Force Speed already running only a
+   plan solved with it fits; without it, either kind does (the bot can bring
+   Speed up), and the one that needs no mana is preferred. */
+static BotRunJump *Bot_RunJumpPlan(SithThing *self,int from,int to)
+{
+    int active=self->actorParams.extraSpeed>0.01f;
+    BotRunJump *found=NULL;
+    for (int i=0;i<nav.runCount;i++) {
+        BotRunJump *plan=&nav.runEdges[i];
+        if (plan->from!=from || plan->to!=to || (active && !plan->sped)) continue;
+        if (!found || (!active && found->sped && !plan->sped)) found=plan;
+    }
+    return found;
+}
+
+static int Bot_RunJumpRank(SithThing *self,int bin)
+{ return bot.forceEnabled ? (int)Bot_Clamp(sithInventory_GetInventory(self,bin),0,4) : 0; }
+
+/* Planner gate: the powers the plan was solved with, and the mana for them. */
+static int Bot_RunJumpUsable(SithThing *self,int from,int to)
+{
+    BotRunJump *plan=Bot_RunJumpPlan(self,from,to);
+    if (!plan || !BT_ON(RUN_JUMP) || self->actorParams.health<40 || plan->failedUntil>bot.now) return 0;
+    if (plan->sped && Bot_RunJumpRank(self,SITHBIN_F_SPEED)!=plan->speedRank) return 0;
+    if (plan->force && Bot_RunJumpRank(self,SITHBIN_F_JUMP)<plan->jumpRank) return 0;
+    flex_t need=(plan->force ? Bot_ForceCost(self,SITHBIN_F_JUMP) : 0)+
+                (plan->sped && self->actorParams.extraSpeed<=0.01f ? Bot_ForceCost(self,SITHBIN_F_SPEED) : 0);
+    return need<=0 || sithInventory_GetInventory(self,SITHBIN_FORCEMANA)>=need+5.0f;
+}
+
+/* After the ordinary graph: one node a tick, a few far landings each, kept
+   only where the jump saves a long way round. */
+static void Bot_RunJumpBuildStep(SithThing *self)
+{
+    static flex_t distance[BOT_NODES]; static int parent[BOT_NODES];
+    if (!bot.graphDone || !self || nav.runCursor>=bot.nNodes || nav.runCount>=BOT_RUNJUMPS ||
+        (self->flags&SITH_TF_DEAD) || self->actorParams.health<=0) return;
+    int i=nav.runCursor++, speedRank=Bot_RunJumpRank(self,SITHBIN_F_SPEED), jumpRank=Bot_RunJumpRank(self,SITHBIN_F_JUMP);
+    BotNode *a=&bot.nodes[i];
+    if ((a->sector->flags&SITH_SECTOR_UNDERWATER) || nav.liftForNode[i] || !Bot_SectorSafe(a->sector)) goto done;
+    /* Landings worth a jump: a long way round by the ordinary graph, and a
+       real gap in between. The three that save the most are tried. */
+    /* Dry landings are ranked by the detour they save. Water below is all
+       one pool to swim in: the nearest places are tried first, until one
+       can be reached. */
+    int best[3]={-1,-1,-1},pool[8]; flex_t saved[3]={-1,-1,-1},near[8],poolSaved[8];
+    for (int k=0;k<8;k++) { pool[k]=-1; near[k]=1e20f; poolSaved[k]=0; }
+    Bot_PathDistances(self,i,distance,parent);
+    for (int j=0;j<bot.nNodes;j++) {
+        BotNode *b=&bot.nodes[j];
+        if (j==i || nav.liftForNode[j]) continue;
+        int wet=(b->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+        rdVector3 d=Bot_Sub(b->pos,a->pos);
+        flex_t horizontal=Bot_Horizontal(d);
+        if (wet ? (horizontal<0.3f || horizontal>3.6f || d.z>-0.9f || d.z<-9.0f)
+                : (horizontal<1.3f || horizontal>4.6f || fabsf(d.z)>1.2f)) continue;
+        /* A place the ordinary graph cannot reach has no known way back. */
+        if (distance[j]>=1e19f) continue;
+        if (distance[j]<3.0f*horizontal+4.0f) { runJumpDropped[0]++; continue; }
+        flex_t saving=distance[j]-horizontal;
+        if (wet) {
+            for (int k=0;k<8;k++) if (horizontal<near[k]) {
+                for (int m=7;m>k;m--) { pool[m]=pool[m-1]; near[m]=near[m-1]; poolSaved[m]=poolSaved[m-1]; }
+                pool[k]=j; near[k]=horizontal; poolSaved[k]=saving; break;
+            }
+            continue;
+        }
+        if (saving<=saved[2]) continue;
+        rdVector3 middle=Bot_Mix(a->pos,b->pos,0.5f),floor; SithSector *support=NULL;
+        middle.z=Bot_Max(a->pos.z,b->pos.z);
+        SithSector *over=Bot_SectorAt(&middle,a->sector);
+        if (!over || Bot_Floor(middle,over,BOT_FOOT_HEIGHT+0.9f,&floor,&support)) continue;
+        for (int k=0;k<3;k++) if (saving>saved[k]) {
+            for (int m=2;m>k;m--) { best[m]=best[m-1]; saved[m]=saved[m-1]; }
+            best[k]=j; saved[k]=saving; break;
+        }
+    }
+    for (int order=0,added=0,dives=0;order<11 && added<2 && nav.runCount<BOT_RUNJUMPS;order++) {
+        int j=order<8 ? pool[order] : best[order-8];
+        flex_t worth=order<8 ? poolSaved[order] : saved[order-8];
+        if (j<0 || (order<8 && dives)) continue;
+        BotRunJump plan={0};
+        BotRunJump other={0}; int both=0;
+        if (bot.nodes[j].sector->flags&SITH_SECTOR_UNDERWATER) {
+            int plain=Bot_RunDiveSolve(self,a,&bot.nodes[j],speedRank,0,&plan);
+            int fast=speedRank>0 && Bot_RunDiveSolve(self,a,&bot.nodes[j],speedRank,1,plain ? &other : &plan);
+            if (!plain && !fast) continue;
+            both=plain && fast;
+        } else if (!Bot_RunJumpSolve(self,a,&bot.nodes[j],speedRank,jumpRank,&plan)) continue;
+        plan.from=i; plan.to=j; plan.speedRank=speedRank; plan.jumpRank=jumpRank;
+        if (a->nEdges>=BOT_EDGES || nav.runCount+both>=BOT_RUNJUMPS) continue;
+        nav.runEdges[nav.runCount++]=plan;
+        if (both) { other.from=i; other.to=j; other.speedRank=speedRank; other.jumpRank=jumpRank; nav.runEdges[nav.runCount++]=other; }
+        Bot_AddEdge(i,j,BOT_ROUTE_RUNJUMP); added++; dives+=plan.dive;
+        rdVector3 gap=Bot_Sub(bot.nodes[j].pos,a->pos);
+        fprintf(stderr,"BOT_RUNJUMP name=%s event=edge from=%d to=%d at=%.2f,%.2f,%.2f land=%.2f,%.2f,%.2f distance=%.2f rise=%.2f "
+            "speed=%.2f force_speed=%d strafe=%d force_jump=%d hold=%.2f runway=%.2f sprint=%.2f flight=%.2f saved=%.1f dive=%d walk=%d speed_states=%d\n",
+            bot.name,i,j,(double)a->pos.x,(double)a->pos.y,(double)a->pos.z,
+            (double)bot.nodes[j].pos.x,(double)bot.nodes[j].pos.y,(double)bot.nodes[j].pos.z,
+            (double)Bot_Horizontal(gap),(double)gap.z,(double)plan.speed,plan.sped,plan.boost,plan.force,
+            (double)plan.hold,(double)plan.runway,(double)plan.sprint,(double)plan.seconds,(double)worth,plan.dive,plan.walk,1+both);
+    }
+done:
+    if (nav.runCursor>=bot.nNodes) {
+        fprintf(stderr,"BOT_RUNJUMP name=%s event=ready edges=%d speed_rank=%d jump_rank=%d short_detour=%d no_launch=%d no_runway=%d blocked=%d\n",
+            bot.name,nav.runCount,speedRank,jumpRank,runJumpDropped[0],runJumpDropped[1],runJumpDropped[2],runJumpDropped[3]);
+        memset(runJumpDropped,0,sizeof(runJumpDropped));
+        fflush(stderr);
+    }
+}
+
+/* Set the edge aside: briefly when the moment was wrong, for a minute after
+   a miss, for the map when the run-up itself cannot be walked. */
+static void RunJump_Fail(SithThing *self,BotRunJump *plan,const char *why,flex_t seconds)
+{
+    plan->failedUntil=bot.now+seconds;
+    if (bot.forceBin==SITHBIN_F_JUMP) bot.forceUntil=bot.now;
+    fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=fail why=%s from=%d to=%d phase=%d pos=%.2f,%.2f,%.2f health=%.0f\n",
+        bot.name,(double)bot.now,why,plan->from,plan->to,nav.runPhase,
+        (double)self->position.x,(double)self->position.y,(double)self->position.z,(double)self->actorParams.health);
+    nav.runPhase=0; nav.runFrom=nav.runTo=nav.runActive=0;
+    bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+}
+
+/* The route follower may move on to the next leg before the feet touch.
+   Every flight is followed to its end here, for the log and for the edge's
+   record: a landing anywhere but the foothold sets the edge aside. */
+static void Bot_RunJumpWatch(SithThing *self)
+{
+    /* Force Speed lasts 5 + 2.5 a rank from the moment it comes up. */
+    if (self->actorParams.extraSpeed<=0.01f) nav.runSpedAt=0;
+    else if (nav.runSpedAt<=0) nav.runSpedAt=bot.now;
+    if (nav.runFlight<1 || nav.runFlight>nav.runCount) { nav.runFlight=0; return; }
+    BotRunJump *plan=&nav.runEdges[nav.runFlight-1];
+    BotNode *b=&bot.nodes[plan->to];
+    int dead=(self->flags&SITH_TF_DEAD)!=0 || self->actorParams.health<=0;
+    int wet=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    if (!dead && !wet && !(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))) return;
+    flex_t miss=Bot_Horizontal(Bot_Sub(b->pos,self->position)),dz=self->position.z-b->pos.z;
+    int ok=plan->dive ? (!dead && wet) : (!dead && !wet && fabsf(dz)<=0.25f && miss<=0.9f);
+    fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=land from=%d to=%d ok=%d miss=%.2f dz=%.2f lost=%.0f health=%.0f dead=%d wet=%d\n",
+        bot.name,(double)bot.now,plan->from,plan->to,ok,(double)miss,(double)dz,
+        (double)(nav.runHealth-self->actorParams.health),(double)self->actorParams.health,dead,wet);
+    if (!ok) plan->failedUntil=bot.now+60.0f;
+    nav.runFlight=0; nav.runLogged=0;
+}
+
+/* Phases: 0 walk to the start of the run-up, bring up Force Speed, stand
+   and face the line; 1 timed launch, with the Force Jump key held so that it
+   comes up as the sprint reaches the launch node; 2 flight; 4 landed. There
+   is no stopping once the sprint starts: the run-up is too short for that. */
+static int Bot_RunJumpMove(SithThing *self,int from,int nodeIndex)
+{
+    if (nav.runFrom!=from+1 || nav.runTo!=nodeIndex+1 || bot.now-nav.runSeen>0.6f) {
+        nav.runFrom=from+1; nav.runTo=nodeIndex+1; nav.runPhase=0; nav.runActive=0;
+        nav.runUntil=bot.now+7.0f; nav.runAir=nav.runLogged=0;
+    }
+    BotRunJump *plan=nav.runPhase>0 && nav.runActive>0 && nav.runActive<=nav.runCount ? &nav.runEdges[nav.runActive-1]
+                                                                                   : Bot_RunJumpPlan(self,from,nodeIndex);
+    if (plan && plan->dive && (self->sector->flags&SITH_SECTOR_UNDERWATER)) return 0; /* in the water: the swim takes over */
+    if (!plan) {
+        /* Nothing solved for the speed the bot has right now. */
+        nav.runPhase=0; nav.runFrom=nav.runTo=nav.runActive=0;
+        bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+        return 1;
+    }
+    BotNode *a=&bot.nodes[from],*b=&bot.nodes[nodeIndex];
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    nav.runSeen=bot.now; nav.waitUntil=bot.now+0.3f;
+    bot.routeMode=BOT_ROUTE_RUNJUMP; bot.routeAim=1; bot.moveRun=bot.moveBoost=0;
+    if (bot.nextPlan<bot.now+1.0f) bot.nextPlan=bot.now+1.0f;
+    if ((self->sector->flags&SITH_SECTOR_UNDERWATER) || bot.now>nav.runUntil) { RunJump_Fail(self,plan,"timeout",60.0f); return 1; }
+    int grounded=(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))!=0;
+    flex_t turn=plan->boost ? ((from&1) ? BOT_DIAGONAL_ANGLE : -BOT_DIAGONAL_ANGLE) : 0;
+    rdVector3 look={direction.x*cosf(turn)-direction.y*sinf(turn),direction.x*sinf(turn)+direction.y*cosf(turn),0};
+    rdVector3 lookAt={self->position.x+look.x,self->position.y+look.y,self->position.z};
+    flex_t extra=plan->sped ? RunJump_Boost(plan->speedRank) : 0;
+    if (nav.runPhase==0) {
+        if (!grounded) return 1;
+        /* The leg may have been planned from the nearest node, not from where
+           the bot stands: the run-up must be level ground it can walk. */
+        BotNode actual={.pos=self->position,.sector=self->sector}; int drop=0;
+        if (fabsf(self->position.z-a->pos.z)>0.08f ||
+            (Bot_Horizontal(Bot_Sub(a->pos,self->position))>0.05f && (!Bot_WalkableSpan(&actual,a,&drop,0.001f) || drop))) {
+            RunJump_Fail(self,plan,"not-at-launch",15.0f); return 1;
+        }
+        rdVector3 start=a->pos; start.x-=plan->runway*direction.x; start.y-=plan->runway*direction.y;
+        rdVector3 toStart=Bot_Sub(start,self->position); toStart.z=0;
+        if (Bot_Horizontal(toStart)>0.045f) {
+            start.z=self->position.z; Bot_Aim(self,start,0);
+            if (!Bot_NavDirectMove(self,start,0)) RunJump_Fail(self,plan,"runway-blocked",900.0f);
+            return 1;
+        }
+        Bot_Aim(self,lookAt,0);
+        if (plan->sped && self->actorParams.extraSpeed<=0.01f) {
+            if (bot.forceBin<0 && bot.now>=bot.nextForce) {
+                flex_t cost=Bot_ForceCost(self,SITHBIN_F_SPEED)+(plan->force ? Bot_ForceCost(self,SITHBIN_F_JUMP) : 0);
+                if (!Bot_ForceReady(self,SITHBIN_F_SPEED,cost) || !Bot_RequestForce(self,SITHBIN_F_SPEED,0.10f,-1))
+                    RunJump_Fail(self,plan,"no-speed",15.0f);
+            }
+            return 1;
+        }
+        if (plan->sped && fabsf(self->actorParams.extraSpeed-extra)>0.05f) { RunJump_Fail(self,plan,"speed-rank",60.0f); return 1; }
+        /* Speed that would run out before the launch is left to run out, and
+           brought up fresh. */
+        if (plan->sped && nav.runSpedAt>0 &&
+            nav.runSpedAt+5.0f+2.5f*plan->speedRank-bot.now<Bot_Max(plan->hold,plan->sprint)+0.8f) { nav.runUntil=Bot_Max(nav.runUntil,bot.now+3.0f); return 1; }
+        if (!plan->sped && self->actorParams.extraSpeed>0.01f) return 1; /* the lookup picks the other plan next tick */
+        if (bot.forceBin>=0 || (plan->force && bot.now<bot.nextForce) ||
+            Bot_Dot(look,self->orient.lvec)<0.995f || Bot_Horizontal(self->physicsParams.vel)>0.05f) return 1;
+        if (plan->force && !Bot_ForceReady(self,SITHBIN_F_JUMP,Bot_ForceCost(self,SITHBIN_F_JUMP))) { RunJump_Fail(self,plan,"no-mana",15.0f); return 1; }
+        /* Both the key and the sprint are timed back from one release. */
+        nav.runPhase=1; nav.runAir=0; nav.runHeld=0; nav.runActive=(int)(plan-nav.runEdges)+1;
+        nav.runRelease=bot.now+Bot_Max(plan->hold,plan->sprint)+2.0f*bot.frameDt;
+        fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=start from=%d to=%d runway=%.2f speed=%.2f hold=%.2f sprint=%.2f boost=%.1f\n",
+            bot.name,(double)bot.now,from,nodeIndex,(double)plan->runway,(double)plan->speed,(double)plan->hold,
+            (double)plan->sprint,(double)self->actorParams.extraSpeed);
+    }
+    if (nav.runPhase==1) {
+        Bot_Aim(self,lookAt,0);
+        if (!grounded && !plan->dive && bot.now<nav.runRelease-0.08f) { RunJump_Fail(self,plan,"knocked-off",15.0f); return 1; }
+        if (!grounded) { nav.runPhase=2; nav.runAir=1; }
+        else {
+            if (plan->force && !nav.runHeld && bot.now>=nav.runRelease-plan->hold) {
+                if (!Bot_RequestForce(self,SITHBIN_F_JUMP,Bot_Max(0.15f,nav.runRelease-bot.now),-1)) { RunJump_Fail(self,plan,"no-jump",15.0f); return 1; }
+                nav.runHeld=1;
+            }
+            if (bot.now>=nav.runRelease-plan->sprint) {
+                rdVector3 offset=Bot_Sub(self->position,a->pos); offset.z=0;
+                flex_t along=Bot_Dot(offset,direction);
+                rdVector3 desired={direction.x-2.0f*(offset.x-along*direction.x),direction.y-2.0f*(offset.y-along*direction.y),0};
+                Bot_ThrustAxes(self,desired,plan->boost); bot.keys[INPUT_FUNC_FAST]=!plan->walk;
+            }
+            if (!plan->force && !plan->dive && bot.now>=nav.runRelease) { bot.keys[INPUT_FUNC_JUMP]=1; }
+            if (bot.now>nav.runRelease+(plan->dive ? 0.8f : 0.30f)) { RunJump_Fail(self,plan,"no-takeoff",60.0f); return 1; }
+            return 1;
+        }
+    }
+    if (nav.runPhase==2) {
+        Bot_Aim(self,lookAt,0);
+        if (!grounded) {
+            if (!nav.runLogged) {
+                nav.runLogged=1; nav.runFlight=(int)(plan-nav.runEdges)+1; nav.runHealth=self->actorParams.health;
+                fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=launch from=%d to=%d pace=%.2f wanted=%.2f up=%.2f pos=%.2f,%.2f late=%.2f\n",
+                    bot.name,(double)bot.now,from,nodeIndex,(double)Bot_Dot(self->physicsParams.vel,direction),(double)plan->speed,
+                    (double)self->physicsParams.vel.z,(double)self->position.x,(double)self->position.y,(double)(bot.now-nav.runRelease));
+            }
+            Bot_ThrustAxes(self,direction,plan->boost); return 1;
+        }
+        nav.runLogged=0;
+        if (fabsf(self->position.z-b->pos.z)>0.25f || Bot_Horizontal(Bot_Sub(b->pos,self->position))>0.9f) { RunJump_Fail(self,plan,"missed",60.0f); return 1; }
+        nav.runPhase=4;
+    }
+    /* Landed: an ordinary walk to the node. */
+    rdVector3 toNode=Bot_Sub(b->pos,self->position);
+    if (Bot_Horizontal(toNode)>0.03f) Bot_Move(self,toNode,0);
+    return 1;
+}
