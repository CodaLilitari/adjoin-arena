+static void Bot_InjectShaftEdges(void)
+{
+    for (int d=0;d<botShaftDeckCount;d++) {
+        int deckNode=botShaftDecks[d];
+        BotNode *deck=&bot.nodes[deckNode];
+        rdVector3 below=deck->pos; SithSector *belowSector=NULL;
+        for (int step=0;step<48;step++) {
+            below.z-=0.25f;
+            SithSector *s=Bot_SectorAt(&below,deck->sector);
+            if (s && s!=deck->sector && Bot_SectorSafe(s)) { belowSector=s; break; }
+        }
+        if (!belowSector) continue;
+        int best=-1; flex_t bestDist=1e20f;
+        for (int i=0;i<bot.nNodes;i++) {
+            if (bot.nodes[i].sector!=belowSector) continue;
+            flex_t dist=Bot_Distance(deck->pos,bot.nodes[i].pos);
+            if (dist<bestDist) { bestDist=dist; best=i; }
+        }
+        if (best<0) continue;
+        Bot_AddEdge(deckNode,best,BOT_ROUTE_DROP);
+        Bot_AddEdge(best,deckNode,Bot_NodeSubmerged(&bot.nodes[best]) ? BOT_ROUTE_FORCEJUMP : BOT_ROUTE_JUMP);
+        SithSector *aboveSector=NULL;
+        for (int pass=0;pass<2 && !aboveSector;pass++)
+        for (int si=0;si<bot.world->numSurfaces && !aboveSector;si++) {
+            SithSurface *surface=&bot.world->surfaces[si];
+            if (surface->pSector!=deck->sector || !surface->pAdjoin) continue;
+            flex_t nz=surface->surfaceInfo.face.normal.z;
+            if (pass==0 ? nz>-0.9f : (nz<0.9f || surface->pAdjoin->sector==belowSector)) continue;
+            if (surface->pAdjoin->sector && surface->pAdjoin->sector!=deck->sector)
+                aboveSector=surface->pAdjoin->sector;
+        }
+        int bestIn=-1; flex_t bestInDist=1e20f;
+        for (int i=0;i<bot.nNodes;i++) {
+            if (i==deckNode || !aboveSector || bot.nodes[i].sector!=aboveSector || bot.nodes[i].nEdges>=BOT_PLAIN_EDGES) continue;
+            flex_t dist=Bot_Distance(deck->pos,bot.nodes[i].pos);
+            if (dist<bestInDist) { bestInDist=dist; bestIn=i; }
+        }
+        if (bestIn>=0 && bestInDist<1.2f) {
+            int beforeDeck=bot.nodes[deckNode].nEdges, beforeIn=bot.nodes[bestIn].nEdges;
+            Bot_AddEdge(bestIn,deckNode,BOT_ROUTE_WALK);
+            Bot_AddEdge(deckNode,bestIn,BOT_ROUTE_WALK);
+            fprintf(stderr,"BOT_LIFT name=%s event=board-inject deck=%d in=%d insector=%d dist=%.2f edges %d->%d %d->%d\n",
+                bot.name,deckNode,bestIn,bot.nodes[bestIn].sector ? (int)bot.nodes[bestIn].sector->id : -1,
+                (double)bestInDist,beforeDeck,bot.nodes[deckNode].nEdges,beforeIn,bot.nodes[bestIn].nEdges);
+            fflush(stderr);
+        }
+        fprintf(stderr,"BOT_LIFT name=%s event=shaft-inject deck=%d below=%d belowsector=%d dist=%.2f\n",
+            bot.name,deckNode,best,(int)belowSector->id,(double)bestDist);
+        fflush(stderr);
+    }
+}
