+static int Bot_WalkableStepped(BotNode *a, BotNode *b, int *isDrop)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta);
+    int dropping=(delta.z < -BOT_STEP_UP);
+    if (length>3.5f || length<0.025f || delta.z>BOT_STEP_UP || delta.z < -BOT_MAX_DROP) return 0;
+    int steps=(int)ceilf(length/0.11f);
+    if (steps<2) steps=2;
+    if (steps>32) return 0;
+    rdVector3 pts[34]; SithSector *secs[34];
+    pts[0]=a->pos; secs[0]=a->sector;
+    flex_t previousZ=a->pos.z; SithSector *hint=a->sector;
+    for (int i=1;i<steps;i++) {
+        rdVector3 p=Bot_Mix(a->pos,b->pos,(flex_t)i/(flex_t)steps), floor;
+        p.z=Bot_Max(previousZ,p.z)+0.02f;
+        SithSector *floorSector;
+        if (!Bot_Floor(p,hint,dropping ? BOT_MAX_DROP+0.3f : 0.52f,&floor,&floorSector)) return 0;
+        if (floor.z-previousZ>BOT_STEP_UP || previousZ-floor.z>BOT_MAX_DROP) return 0;
+        pts[i]=floor; secs[i]=floorSector;
+        { flex_t lerpZ=a->pos.z+(b->pos.z-a->pos.z)*(flex_t)i/(flex_t)steps;
+          flex_t z=lerpZ<floor.z-0.05f ? floor.z-0.05f : lerpZ;
+          pts[i].z=z>floor.z ? floor.z : z; }
+        previousZ=floor.z; hint=floorSector;
+    }
+    pts[steps]=b->pos; secs[steps]=b->sector;
+    {
+        rdVector3 p=b->pos, floor; SithSector *floorSector;
+        p.z=Bot_Max(previousZ,p.z)+0.02f;
+        if (!Bot_Floor(p,hint,dropping ? BOT_MAX_DROP+0.3f : 0.52f,&floor,&floorSector)) return 0;
+        if (floor.z-previousZ>BOT_STEP_UP || previousZ-floor.z>BOT_MAX_DROP) return 0;
+        if (fabsf(floor.z-b->pos.z)>0.2f) return 0;
+    }
+    for (int i=0;i<steps;i++)
+        if (!Bot_Clear(NULL,secs[i],pts[i],pts[i+1],0.045f,1)) return 0;
+    *isDrop=dropping;
+    return 1;
+}
