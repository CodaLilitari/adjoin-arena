+/* Ordinary sessions need just edge outcomes. Leave the larger research
+ * trace disabled between observations. */
+static void Bot_ObserveTravel(int node,int failed)
+{
+    const int trace=transfer.trace;
+    const char *observe=getenv("JK_BOT_NAV_OBSERVE");
+    if (observe && !strcmp(observe,"1")) transfer.trace=1;
+    Transfer_Observe(node,failed);
+    transfer.trace=trace;
+}
