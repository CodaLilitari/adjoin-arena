+/* Research-only interlock for the controlled opening. No wall-clock timeout
+ * can open it: both transitions must be seen on the same owning player. */
+static struct {
+    int mode, phase, slot;
+    uint32_t signature;
+    const SithWorld *world;
+} plannerGate;
+
+static int Bot_PlannerDormant(void)
+{
+    return plannerGate.mode == 1 && plannerGate.phase != 2;
+}
+
+static void Bot_ObservePlannerGate(SithThing *self)
+{
+    if (plannerGate.mode < 0 || plannerGate.phase == 2) return;
+    int slot = sithPlayer_GetThingPlayerNum(self);
+    if (slot != 1 && slot != 2) return;
+    unsigned mask = self->actorParams.flags & (SITH_AF_IMMOBILE | SITH_AF_CONTROLSDISABLED);
+    int gravity = !!(self->physicsParams.flags & SITH_PF_USEGRAVITY);
+    const char *phase;
+    if (plannerGate.phase == 0 && mask == (SITH_AF_IMMOBILE | SITH_AF_CONTROLSDISABLED) &&
+        !gravity && self->collide == 0) {
+        plannerGate.slot = slot;
+        plannerGate.signature = self->signature;
+        plannerGate.world = sithWorld_g_pCurrentWorld;
+        plannerGate.phase = 1;
+        phase = "held";
+    } else if (plannerGate.phase == 1 && plannerGate.slot == slot &&
+               plannerGate.world == sithWorld_g_pCurrentWorld && plannerGate.signature == self->signature &&
+               mask == 0 && gravity && self->collide == SITH_COLLIDE_SPHERE) {
+        plannerGate.phase = 2;
+        phase = "released";
+    } else return;
+    fprintf(stderr, "BOT_PLANNER_GATE name=%s mode=%s phase=%s slot=%d game_ms=%u policy_s=%.6f "
+            "actor_mask=%u gravity=%d collision=%d\n", bot.name, plannerGate.mode ? "on" : "off",
+            phase, slot, (unsigned)sithTime_g_msecGameTime, (double)bot.now, mask, gravity, (int)self->collide);
+    fflush(stderr);
+}
+
