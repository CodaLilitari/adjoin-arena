+static int Bot_StandingFloor(rdVector3 p, SithSector *hint, flex_t depth,
+                             rdVector3 *standing, SithSector **outSector, int platform, int *fixture)
 {
     rdVector3 down={0,0,-1};
     SithCollision *hit;
     SithSector *sector=Bot_SectorAt(&p,hint);
