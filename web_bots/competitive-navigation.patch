+/* Final ordinary-ground input check. A lateral coast can put the body over
+   a catwalk even if the next requested direction is along the catwalk. */
+static void Bot_GuardGround(SithThing *self)
+{
+    if (nav.shelfBackUntil>bot.now && nav.shelfLift>0 && nav.shelfLift<=nav.liftCount) {
+        SithThing *deck=Bot_NavThing(nav.lifts[nav.shelfLift-1].thing);
+        if (deck && self->attachedThing==deck) {
+            rdVector3 back=Bot_Sub(deck->position,self->position);
+            if (Bot_Horizontal(back)>0.035f) Bot_ThrustAxes(self,back,0);
+            else bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+            bot.keys[INPUT_FUNC_FAST]=bot.keys[INPUT_FUNC_JUMP]=0;
+            nav.waitUntil=bot.now+0.2f;
+            return;
+        }
+    }
+    if (nav.dismountUntil>bot.now && nav.shelfLift>0 && nav.shelfLift<=nav.liftCount) {
+        const BotLift *lift=&nav.lifts[nav.shelfLift-1];
+        SithThing *deck=Bot_NavThing(lift->thing);
+        if (deck && self->attachedThing==deck) {
+            nav.waitUntil=bot.now+0.25f;
+            for (int k=0;k<2;k++) {
+                const BotNode *stop=&bot.nodes[lift->node[k]];
+                if (fabsf(deck->position.z+lift->top+BOT_FOOT_HEIGHT-stop->pos.z)>0.045f) continue;
+                int best=-1; flex_t nearest=1e6f;
+                for (int j=0;j<stop->nEdges;j++) {
+                    const BotEdge *edge=&stop->edges[j]; const BotNode *next=&bot.nodes[edge->to];
+                    flex_t dist=Bot_Horizontal(Bot_Sub(stop->pos,next->pos));
+                    if (edge->drop==BOT_ROUTE_LIFT && !nav.liftForNode[edge->to] &&
+                        fabsf(next->pos.z-stop->pos.z)<0.10f && dist>0.12f && dist<nearest) {
+                        best=edge->to; nearest=dist;
+                    }
+                }
+                if (best>=0) {
+                    Bot_Aim(self,bot.nodes[best].pos,0); Bot_AxisMove(self,stop->pos,bot.nodes[best].pos);
+                    bot.keys[INPUT_FUNC_FAST]=bot.keys[INPUT_FUNC_JUMP]=0;
+                    return;
+                }
+            }
+            bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+            bot.keys[INPUT_FUNC_FAST]=bot.keys[INPUT_FUNC_JUMP]=0;
+            return;
+        }
+        if (self->attach_flags&SITH_ATTACH_SURFACE) nav.dismountUntil=0;
+    }
+    if (!(self->attach_flags&SITH_ATTACH_SURFACE) || !self->sector ||
+        self->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY)) return;
+    flex_t radius=Bot_Max(self->moveSize,0.025f);
+    flex_t f=bot.axes[INPUT_FUNC_FORWARD], s=bot.axes[INPUT_FUNC_SLIDE]*BOT_STRAFE_GAIN;
+    if (f<0) f*=0.5f;
+    rdVector3 input={f*self->orient.lvec.x+s*self->orient.rvec.x,f*self->orient.lvec.y+s*self->orient.rvec.y,0};
+    rdVector3 velocity=self->physicsParams.vel;
+    flex_t speed=Bot_Horizontal(velocity), drag=self->physicsParams.surfDrag;
+    /* On the floor below a raised vertical elevator, stay outside the
+       swept footprint. If already underneath it, take the nearest supported
+       exit. Use measured model bounds, not an approximate pickup radius. */
+    for (int i=0;i<nav.liftCount;i++) {
+        const BotLift *lift=&nav.lifts[i];
+        SithThing *deck=Bot_NavThing(lift->thing);
+        if (!deck || !deck->trackParams.aFrames || deck->trackParams.loadedFrames!=2 ||
+            lift->maxX<=lift->minX || lift->maxY<=lift->minY) continue;
+        const SithPathFrame *frames=deck->trackParams.aFrames;
+        if (Bot_Horizontal(Bot_Sub(frames[0].pos,frames[1].pos))>=0.025f) continue;
+        flex_t foot=self->position.z-BOT_FOOT_HEIGHT;
+        if (deck->position.z+lift->bottom < foot+0.025f ||
+            foot<Bot_Min(frames[0].pos.z,frames[1].pos.z)+lift->bottom-0.20f) continue;
+        rdVector3 pos=Bot_Sub(self->position,deck->position);
+        flex_t margin=radius*0.55f;
+        flex_t distances[4]={pos.x-lift->minX+margin,lift->maxX-pos.x+margin,
+                             pos.y-lift->minY+margin,lift->maxY-pos.y+margin};
+        int nearest=0;
+        for (int j=1;j<4;j++) if (distances[j]<distances[nearest]) nearest=j;
+        rdVector3 dirs[4]={{-1,0,0},{1,0,0},{0,-1,0},{0,1,0}};
+        if (distances[nearest]<0) {
+            rdVector3 next={pos.x+input.x*0.13f+velocity.x*0.09f,pos.y+input.y*0.13f+velocity.y*0.09f,0};
+            if (next.x<lift->minX-margin || next.x>lift->maxX+margin ||
+                next.y<lift->minY-margin || next.y>lift->maxY+margin) continue;
+            if (Bot_Dot(velocity,dirs[nearest])<-0.06f) Bot_ThrustAxes(self,dirs[nearest],0);
+            else bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+        } else {
+            rdVector3 blocked;
+            int escape=-1; flex_t best=1e6f;
+            for (int j=0;j<4;j++) if (distances[j]<best &&
+                Bot_GroundCorridor(self,dirs[j],0,distances[j]+radius,0,&blocked)) { escape=j; best=distances[j]; }
+            if (escape<0) continue;
+            Bot_ThrustAxes(self,dirs[escape],0);
+        }
+        bot.keys[INPUT_FUNC_FAST]=bot.keys[INPUT_FUNC_JUMP]=0;
+        return;
+    }
+
+    if (bot.keys[INPUT_FUNC_JUMP] || nav.jumpUntil>bot.now || nav.forceJumpPending ||
+        nav.hopUntil>bot.now || nav.liftStep || bot.routeMode==BOT_ROUTE_LIFT ||
+        bot.routeMode==BOT_ROUTE_DROP || bot.routeMode==BOT_ROUTE_RUNJUMP ||
+        bot.routeMode==BOT_ROUTE_WATER_ENTRY || bot.routeMode==BOT_ROUTE_WATER_EXIT) return;
+    rdVector3 pos=self->position, floor;
+    SithSector *sector;
+    pos.z+=0.03f;
+    if (!Bot_Floor(pos,self->sector,BOT_FOOT_HEIGHT+0.31f,&floor,&sector)) {
+        /* A body may remain attached with the origin a few hundredths past
+           the rim. Find footing within the body's radius, then move onto it. */
+        rdVector3 toward={0};
+        for (int i=0;i<8;i++) {
+            flex_t angle=(flex_t)i*(flex_t)M_PI/4.0f;
+            rdVector3 dir={cosf(angle),sinf(angle),0};
+            rdVector3 foot={pos.x+dir.x*radius*0.85f,pos.y+dir.y*radius*0.85f,pos.z};
+            if (Bot_Floor(foot,self->sector,BOT_FOOT_HEIGHT+0.12f,&floor,&sector) &&
+                fabsf(floor.z-self->position.z)<0.09f && Bot_Clear(self,self->sector,self->position,floor,radius*0.8f,0)) {
+                toward.x+=dir.x; toward.y+=dir.y;
+            }
+        }
+        if (Bot_Horizontal(toward)>0.1f) { Bot_ThrustAxes(self,toward,0); bot.keys[INPUT_FUNC_FAST]=0; }
+        return;
+    }
+    if (speed<0.2f || drag<1.0f) return;
+    rdVector3 dir={velocity.x/speed,velocity.y/speed,0};
+    flex_t coast=Bot_Min(0.65f,speed/drag+speed*Bot_Min(bot.frameDt,0.05f)+0.025f);
+    rdVector3 previous=pos;
+    for (flex_t d=0;d<coast;) {
+        d=Bot_Min(coast,d+0.045f);
+        rdVector3 ahead={pos.x+dir.x*d,pos.y+dir.y*d,previous.z};
+        if (!Bot_Clear(self,self->sector,previous,ahead,radius*0.8f,0)) return;
+        if (!Bot_Floor(ahead,self->sector,BOT_FOOT_HEIGHT+0.31f,&floor,&sector)) {
+            Bot_ThrustAxes(self,(rdVector3){-dir.x,-dir.y,0},0);
+            bot.keys[INPUT_FUNC_FAST]=0;
+            return;
+        }
+        previous=ahead; previous.z=floor.z+0.03f;
+    }
 }
 
