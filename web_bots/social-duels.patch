+// Called only by an ordinary playing bot. An invitation comes from this
+// host-authenticated state, never from public chat. Equip through ordinary
+// inputs, then acknowledge this specific offer at most once.
+int sithDuel_BotTick(void)
+{
+    if (!room() || !header.epoch || !allowed()) return 0;
+    if (sithDuel_PhaseForPlayer(playerThingIdx)) return 1;
+    int i = incoming();
+    if (i < 0) return 0;
+    DuelPair *p = &pairs[i];
+    SithThing *self = sithPlayer_g_pLocalPlayerThing;
+    if (!alive(self) || !nearAndVisible(self, body(p->s.a))) return 0;
+    if (p->botAcceptedGeneration != p->s.generation && sithDuelCombat_CanEnter(self, NULL, 0)) {
+        p->botAcceptedGeneration = p->s.generation;
+        printf("BOT_DUEL accepting slot=%d pair=%d generation=%u\n", playerThingIdx, i, p->s.generation);
+        sendRequest(DUEL_ACCEPT, 0, i);
+    }
+    return 1;
+}
