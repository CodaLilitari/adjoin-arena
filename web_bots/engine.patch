+static int jkGuiMultiplayer_WebFindRoom(const char16_t *name)
+{
+    unsigned started=stdPlatform_GetTimeMsec(), next=started;
+    int pending=0;
+    dplay_dword_55D618=0;
+    stdComm_WSRelay_ForgetList();
+    while ((unsigned)(stdPlatform_GetTimeMsec()-started)<45000u) {
+        unsigned now=stdPlatform_GetTimeMsec();
+        if (pending && stdComm_WSRelay_ListReady()) { pending=0; next=now+700; }
+        if (!pending && (int32_t)(now-next)>=0) {
+            int result=stdComm_EnumSessions(1,NULL);
+            if (result && result!=STDCOMM_WSRELAY_LIST_LATER) return -1;
+            pending=(result==STDCOMM_WSRELAY_LIST_LATER);
+            next=now+700;
+        }
+        int found=-1;
+        if (!pending) for (int i=0;i<dplay_dword_55D618 && i<32;i++) {
+            if (__wcscmp(name,jkGuiMultiplayer_aEntries[i].serverName)) continue;
+            if (found>=0) return -1;
+            found=i;
+        }
+        if (found>=0) return found;
+        emscripten_sleep(20);
+    }
+    return -1;
+}
