+/* Model/sound arguments are resource basenames. The game resolves them from
+   the same private mounts as any manually selected multiplayer character. */
+static int jkGuiMultiplayer_WebName(const char *s,size_t limit,const char *extension)
+{
+    if (!s) return 0;
+    size_t n=strlen(s), ext=extension ? strlen(extension) : 0;
+    if (n<=ext || n>limit || (ext && strcmp(s+n-ext,extension))) return 0;
+    for (size_t i=0;i<n-ext;i++) {
+        char c=s[i];
+        if (!((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') ||
+              c=='-' || c=='_')) return 0;
+    }
+    return 1;
+}
