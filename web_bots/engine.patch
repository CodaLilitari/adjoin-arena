+
+static int Bot_CtfOpponent(SithThing *self,int slot)
+{
+    if (!nav.ctf) return 1;
+    return self->actorParams.pPlayer && self->actorParams.pPlayer->teamNum>0 &&
+        jkPlayer_playerInfos[slot].teamNum>0;
+}
+
+static int Bot_EnemyAllowed(SithThing *self, int slot)
+{
+    /* A blinded client cannot use world coordinates for perfect gun aiming. */
+    if (self->actorParams.flags&SITH_AF_BLIND) return 0;
+    if (!Bot_EnemyBase(self,slot) || Bot_IsPeaceful(self,slot)) return 0;
+    SithThing *t=jkPlayer_playerInfos[slot].pLocalPlayer;
+    if ((t->jkFlags&JKFLAG_PERSUASION) &&
+        !sithInventory_IsInventoryActivated(self,SITHBIN_F_SEEING)) return 0;
+    return 1;
+}
+
+/* The elite gun controller may use synchronized positions even under Blind or
+   Persuasion. Hostile Force checks use their existing eligibility policy. */
+static int Bot_KineticEnemyAllowed(SithThing *self,int slot)
+{
+    if (!bot.elite) return Bot_EnemyAllowed(self,slot);
+    return Bot_EnemyBase(self,slot) && !Bot_IsPeaceful(self,slot);
+}
+
+static int Bot_VisibleTarget(SithThing *self,SithThing *target)
+{
+    rdVector3 delta=Bot_Sub(target->position,self->position);
+    flex_t distance=Bot_Len(delta);
+    return distance>0.0001f && distance<=20.0f &&
+        Bot_Dot(delta,self->orient.lvec)>=-0.12f*distance && sithCollision_HasLOS(self,target,0);
+}
+
+/* Competitive clients may use synchronized world knowledge to acquire in
+   any direction. A wall still blocks the actual weapon and Force actions. */
+static int Bot_CanAcquire(SithThing *self,SithThing *target)
+{
+    if (!bot.elite) return Bot_VisibleTarget(self,target);
+    return isfinite(Bot_Distance(self->position,target->position)) && sithCollision_HasLOS(self,target,0);
+}
+
+static SithThing *Bot_UpdateTarget(SithThing *self)
+{
+    if (!bot.elite && (self->actorParams.flags&SITH_AF_BLIND)) {
+        bot.targetSlot=-1; bot.nextScan=bot.now+(bot.elite ? 0.06f : 0.18f); return NULL;
+    }
+    SithThing *target=NULL;
+    if (Bot_KineticEnemyAllowed(self,bot.targetSlot)) {
+        target=jkPlayer_playerInfos[bot.targetSlot].pLocalPlayer;
+        if ((int)target->guid!=bot.targetGuid || target->signature!=bot.targetSignature ||
+            jkPlayer_playerInfos[bot.targetSlot].playerNetId!=bot.targetNetId || !Bot_CanAcquire(self,target)) {
+            target=NULL; bot.targetSlot=-1;
+        }
+    }
+    if (bot.now>=bot.nextScan) {
+        bot.nextScan=bot.now+(bot.elite ? 0.06f : 0.18f);
+        int bestSlot=-1;
+        flex_t best=1e20f;
+        for (unsigned int i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+            if (!Bot_KineticEnemyAllowed(self,(int)i)) continue;
+            SithThing *t=jkPlayer_playerInfos[i].pLocalPlayer;
+            if (!Bot_CanAcquire(self,t)) continue;
+            flex_t d=Bot_Distance(t->position,self->position);
+            flex_t score=d*(t==target ? 0.65f : 1.0f)*(Bot_ObjectiveCarrier(t) ? 0.40f : 1.0f);
+            if (companion.policy.mode && companion.policy.net==jkPlayer_playerInfos[i].playerNetId &&
+                companion.policy.guid==t->guid && companion.policy.signature==t->signature) score*=0.45f;
+            if (score<best) { best=score; bestSlot=(int)i; }
+        }
+        if (bestSlot>=0) {
+            SithThing *next=jkPlayer_playerInfos[bestSlot].pLocalPlayer;
+            if (next!=target) bot.reactionUntil=bot.now+(bot.elite ?
+                0.08f+Bot_Unit()*0.04f : 0.22f+Bot_Unit()*0.20f);
+            bot.targetSlot=bestSlot; bot.targetGuid=(int)next->guid;
+            bot.targetSignature=next->signature; bot.targetNetId=jkPlayer_playerInfos[bestSlot].playerNetId;
+            bot.seenPos=next->position; bot.seenAt=bot.now; target=next;
+        } else if (!target || bot.now-bot.seenAt>1.7f) {
+            bot.targetSlot=-1; target=NULL;
+        }
+    }
+    return target;
+}
