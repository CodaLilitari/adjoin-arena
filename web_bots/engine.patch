+static int jkGuiMultiplayer_WebCharacter(const char *name,char *model,char *sound,int rank)
+{
+    const char *side=getenv("JK_BOT_FORCE_SIDE"), *style=getenv("JK_BOT_FORCE_STYLE");
+    int dark=side && !strcmp(side,"dark");
+    if (side && !dark && strcmp(side,"light")) return 0;
+    jkBotLoadout plan;
+    if (!jkBotLoadout_Plan(rank,dark,jkBotLoadout_Style(style),&plan)) return 0;
+    char16_t wide[32];
+    stdString_CharToWchar(wide,name,31); wide[31]=0;
+    jkPlayer_CreateConf(wide);
+    jkPlayer_SetMpcInfo(wide,model,sound,"sabergreen1.mat","sabergreen0.mat");
+    for (int bin=SITHBIN_F_JUMP;bin<=SITHBIN_F_DEADLYSIGHT;bin++)
+        sithPlayer_SetInvItemAmount(bin,plan.stars[bin]);
+    jkPlayer_SetRank(rank); jkPlayer_SetChoice(0);
+    sithPlayer_SetInvItemAmount(SITHBIN_NEW_STARS,0);
+    sithPlayer_SetInvItemAmount(SITHBIN_SPEND_STARS,plan.unspent);
+    jkPlayer_SetAccessiblePowers(rank); jkPlayer_SetProtectionDeadlysight();
+    jkPlayer_DisallowOtherSide(rank); jkPlayer_InitForceBins(); jkPlayer_CalcAlignment(1);
+    if (!jkPlayer_MPCWrite(NULL,wide,wide) ||
+        !jkPlayer_MPCParse(&jkGuiMultiplayer_mpcInfo,NULL,wide,wide,1) ||
+        jkGuiMultiplayer_mpcInfo.jediRank!=rank) return 0;
+    jkPlayer_fpslimit=60;
+    jkPlayer_bFastMissionText=1;
+    sithWeapon_controlOptions|=4;
+    return 1;
+}
