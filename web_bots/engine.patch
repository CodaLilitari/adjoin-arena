+EM_JS(int, jkBotWebEmit,(const uint8_t *frame,size_t length), {
+    var sink=Module['onJkBotEvent'];
+    if (typeof sink!=='function') return 0;
+    try { return sink(HEAPU8.slice(frame,frame+length))===false ? 0 : 1; }
+    catch (_) { return 0; }
+});
+EM_JS(int,jkBotWebHosted,(void), {
+    var net=Module['jkNet'];
+    return net && net.session && net.isHost ? 1 : 0;
+});
+EM_JS_DEPS(jkBotWebOptions,"$UTF8ToString,$stringToUTF8,$lengthBytesUTF8");
+EM_JS(int,jkBotWebOption,(const char *field,char *out,int size),{
+    var config=Module['jkBotConfig'];
+    if (!config) return 0;
+    var value=config[UTF8ToString(field)];
+    if (value===undefined) return 0;
+    if (typeof value==='boolean') value=value ? '1':'0';
+    if (typeof value!=='string' || !value.length || value.indexOf(String.fromCharCode(0))>=0 ||
+        lengthBytesUTF8(value)>=size) return -1;
+    stringToUTF8(value,out,size);
+    return 1;
+});
