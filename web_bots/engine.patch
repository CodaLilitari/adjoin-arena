+/* Returns zero for normal play, one for a started bot, negative on a boot error.
+   The four players, including the visible host, use the ordinary WSRelay
+   create/open, level loading and welcome paths. */
+int jkGuiMultiplayer_WebBotStartup(void)
+{
+    if (!jkGuiMultiplayer_WebOptions()) return -1;
+    const char *role=getenv("JK_BOT_WEB_ROLE");
+    if (!role) return 0;
+    const char *name=getenv("JK_BOT_WEB_NAME"), *room=getenv("JK_BOT_WEB_ROOM");
+    char *model=getenv("JK_BOT_WEB_MODEL"), *sound=getenv("JK_BOT_WEB_SOUND");
+    const char *third=getenv("JK_BOT_WEB_THIRD_PERSON");
+    int host=!strcmp(role,"host");
+    const char *mode=getenv("JK_BOT_WEB_MODE");
+    if (!mode) mode="ff-guns";
+    int rank=0, sabers=0;
+    if (!strcmp(mode,"ff-guns")) rank=8;
+    else if (!strcmp(mode,"ff-sabers")) { rank=8; sabers=1; }
+    else if (!strcmp(mode,"nf-sabers")) sabers=1;
+    else if (strcmp(mode,"nf-guns")) return -1;
+    if ((!host && strcmp(role,"join")) || !jkGuiMultiplayer_WebName(name,15,NULL) ||
+        !jkGuiMultiplayer_WebName(room,31,NULL) || !jkGuiMultiplayer_WebName(model,31,".3do") ||
+        !jkGuiMultiplayer_WebName(sound,31,".snd") || (third && strcmp(third,"0") && strcmp(third,"1")) ||
+        Main_bMotsCompat || stdComm_WSRelay_bViewer) return -1;
+    /* Reuse the ordinary bot policy file. These settings restrict AI inputs;
+       the stock MPC rank, COGs, inventory and physics still own every effect. */
+    const char *rules="/jk1/bot-behavior.cfg";
+    FILE *behavior=fopen(rules,"w");
+    if (!behavior) return -1;
+    int written=fprintf(behavior,"version=1\nsabers_only=%d\nfists_peace=0\nforce_enabled=%d\n",sabers,rank>0);
+    int closed=fclose(behavior);
+    if (written<0 || closed!=0 || setenv("JK_BOT_BEHAVIOR_FILE",rules,1)!=0) return -1;
+    webBotThirdPerson=third && !strcmp(third,"1");
+    webBotWorld=NULL;
+    jkBot_Configure(name,model);
+    jkBotCompanion_SetTransport(jkBotWebEmit);
+    jkSmack_stopTick=1; jkSmack_nextGuiState=JK_GAMEMODE_TITLE;
+    Window_SetDrawHandlers(stdDisplay_DrawAndFlipGdi,stdDisplay_SetCooperativeLevel);
+    std3D_StartScene(); std3D_EndScene();
+    if (!sithOpenStatic("static.jkl")) return -1;
+    jkHudInv_InitItems();
+    jkGuiNetHost_bIsDedicated=0;
+    if (stdComm_OpenConnection(NULL)) return -1;
+    char16_t wide[32];
+    stdString_CharToWchar(wide,room,31); wide[31]=0;
+    if (host) {
+        if (!jkGuiMultiplayer_WebCharacter(name,model,sound,rank)) {
+            fprintf(stderr,"BOT_JOIN_REJECTED cannot prepare host's ordinary MPC\n"); return -1;
+        }
+        sithNet_scorelimit=sithNet_multiplayer_timelimit=0;
+        sithMulti_multiModeFlags=MULTIMODEFLAG_SINGLE_LEVEL;
+        if (sithMulti_CreatePlayer(wide,u"","JK1MP","m10.jkl",4,0,
+              MULTIMODEFLAG_SINGLE_LEVEL,TICKRATE_DEFAULT,rank) || !jkBotWebHosted()) {
+            fprintf(stderr,"BOT_JOIN_REJECTED relay did not create the requested room\n"); return -1;
+        }
+        printf("BOT_WEB_HOST netcode=%d episode=JK1MP map=m10.jkl seats=4 mode=%s rank=%d\n",STDCOMM_WSRELAY_NETCODE,mode,rank);
+        return jkMain_loadFile2("JK1MP","m10.jkl") ? 1:-1;
+    }
+    int i=jkGuiMultiplayer_WebFindRoom(wide);
+    if (i<0) { fprintf(stderr,"BOT_JOIN_REJECTED named room missing or ambiguous\n"); return -1; }
+    jkMultiEntry entry=jkGuiMultiplayer_aEntries[i];
+    if (entry.field_E0!=10 || (entry.sessionFlags&SESSIONFLAG_PASSWORD) ||
+        __strcmpi(entry.episodeGobName,"JK1MP") || __strcmpi(entry.mapJklFname,"m10.jkl") ||
+        entry.maxRank!=rank || !jkGuiMultiplayer_WebCharacter(name,model,sound,entry.maxRank)) return -1;
+    char16_t password[2]={0};
+    int error=stdComm_Open(i,password);
+    if (error) {
+        fprintf(stderr,"BOT_JOIN_REJECTED WSRelay refused normal open: %x\n",(unsigned)error);
+        return -1;
+    }
+    sithMulti_multiModeFlags=entry.multiModeFlags;
+    sithMulti_InitTick(entry.tickRateMs);
+    return jkMain_loadFile2(entry.episodeGobName,entry.mapJklFname) ? 1:-1;
+}
