+static int jkGuiMultiplayer_WebOptions(void)
+{
+    static const struct { const char *field,*environment; } options[]={
+        {"role","JK_BOT_WEB_ROLE"},{"room","JK_BOT_WEB_ROOM"},{"name","JK_BOT_WEB_NAME"},
+        {"model","JK_BOT_WEB_MODEL"},{"sound","JK_BOT_WEB_SOUND"},{"thirdPerson","JK_BOT_WEB_THIRD_PERSON"},
+        {"side","JK_BOT_FORCE_SIDE"},{"style","JK_BOT_FORCE_STYLE"},{"elite","JK_BOT_ELITE"},
+        {"mode","JK_BOT_WEB_MODE"}
+    };
+    char value[96];
+    for (unsigned i=0;i<sizeof(options)/sizeof(options[0]);i++) {
+        int status=jkBotWebOption(options[i].field,value,sizeof(value));
+        if (status<0 || (status && setenv(options[i].environment,value,1)!=0)) return 0;
+    }
+    return 1;
+}
