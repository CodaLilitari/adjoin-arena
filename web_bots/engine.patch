+void jkGuiMultiplayer_WebBotBeforeControls(void)
+{
+    if (!jkBot_IsEnabled() || !sithNet_isMulti || (g_submodeFlags&8) ||
+        !sithWorld_g_pCurrentWorld || !sithPlayer_g_pLocalPlayerThing ||
+        !sithPlayer_g_pLocalPlayer || !(sithPlayer_g_pLocalPlayer->flags&1) ||
+        !sithPlayer_g_pLocalPlayer->playerNetId) return;
+    if (webBotWorld!=sithWorld_g_pCurrentWorld) {
+        webBotWorld=sithWorld_g_pCurrentWorld;
+        jkBot_OnJoined();
+        printf("BOT_JOINED slot=%d net=%u map=%s model=%s\n",playerThingIdx,
+            (unsigned)sithPlayer_g_pLocalPlayer->playerNetId,webBotWorld->map_jkl_fname,jkPlayer_model);
+    }
+    if (webBotThirdPerson && sithCamera_g_pCurCamera==&sithCamera_g_aCameras[0] &&
+        !(sithPlayer_g_pLocalPlayerThing->flags&SITH_TF_DEAD)) {
+        sithCamera_g_curCycleCamNum=1;
+        sithCamera_SetCurrentCamera(&sithCamera_g_aCameras[1]);
+    }
+}
