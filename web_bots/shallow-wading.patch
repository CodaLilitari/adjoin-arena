         RAYCAST_200|RAYCAST_800|RAYCAST_2000);
     while ((hit=sithCollision_PopStack())!=NULL) {
-        if ((hit->type&SITHCOLLISION_ADJOINCROSS) && hit->surface &&
-            hit->surface->pAdjoin && !Bot_SectorSafe(hit->surface->pAdjoin->sector)) break;
+        if ((hit->type&SITHCOLLISION_ADJOINCROSS) && hit->surface && hit->surface->pAdjoin) {
+            SithSector *from=hit->surface->pSector, *to=hit->surface->pAdjoin->sector;
+            if (!Bot_SectorSafe(to)) break;
+            if (!(to->flags&SITH_SECTOR_UNDERWATER) ||
