+/* A shallow water bed can carry a standing player with the player's origin in
+   air. Require a measured dry-to-water crossing and a solid, walkable bottom.
+   BGJ's shallow channel is 0.031 units deep; ordinary standing foot height
+   is 0.120. Half a foot height leaves clearance for a dry body on slopes. */
+static int Bot_ShallowBed(SithSurface *s, flex_t immersion, SithSector *body)
+{
+    const int mask=SITH_SURFACE_FLOOR|SITH_SURFACE_HAS_COLLISION|SITH_SURFACE_WATER;
+    const int unstable=SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    return s && !s->pAdjoin && (s->flags&mask)==mask &&
+        !(s->flags&(SITH_SURFACE_VERYDEEPWATER|SITH_SURFACE_ICY|SITH_SURFACE_VERYICY)) &&
+        Bot_SectorSafe(s->pSector) && (s->pSector->flags&SITH_SECTOR_UNDERWATER) &&
+        !(s->pSector->flags&unstable) && Bot_SectorSafe(body) &&
+        !(body->flags&(unstable|SITH_SECTOR_UNDERWATER)) &&
+        immersion>=0.0f && immersion<=BOT_FOOT_HEIGHT*0.5f;
+}
+
