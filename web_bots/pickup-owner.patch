+/* Acknowledged by stock SetItemTaken on the collecting player's client.
+   Check the routed item's identity before destruction or slot reuse. */
+void jkBot_ObserveItemTaken(SithThing *player, const SithThing *item)
+{
+    if (!Lily_Routing() || !player || player != sithPlayer_g_pLocalPlayerThing ||
+        bot.world != sithWorld_g_pCurrentWorld || !item || lily.active.pickupIndex < 0 ||
+        item != Bot_NavThing(lily.active.pickupIndex) ||
+        item->guid != lily.active.pickupGuid || item->signature != lily.active.pickupSignature) return;
+    Lily_Finish(&lily.active, LILY_COMPLETED, 0, LILY_COLLECTED);
+}
