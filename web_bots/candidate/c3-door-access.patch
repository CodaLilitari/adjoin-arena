+/* The stock C3 door scripts check inventory, regardless of selected team. */
+typedef struct {
+    int axis;  /* 0 for a doorway normal to X, 1 for Y */
+    flex_t plane, acrossMin, acrossMax, zMin, zMax;
+} BotC3Opening;
+
+static int Bot_C3ScriptBin(const char *script, int color)
+{
+    if (Bot_NameIs(script,"ctf_doorred.cog")) return 83;
+    if (Bot_NameIs(script,"ctf_doorgold.cog")) return 84;
+    if (Bot_NameIs(script,"c3_sascolored.cog") && (color==1 || color==2)) return 82+color;
+    return 0;
+}
+
+static int Bot_C3Denied(int bin, int paired, flex_t amount, int open)
+{
+    if (!bin || open) return 0;
+    /* Single doors use == 1.0. Paired interior doors reject only zero. */
+    return paired ? amount==0.0f : amount!=1.0f;
+}
+
+static int Bot_C3Crosses(const BotC3Opening *door, rdVector3 a, rdVector3 b)
+{
+    flex_t begin=(door->axis ? a.y : a.x)-door->plane;
+    flex_t end=(door->axis ? b.y : b.x)-door->plane;
+    /* An owner standing on the plane may leave it. */
+    if (begin==0 || (begin>0 && end>0) || (begin<0 && end<0)) return 0;
+    flex_t t=begin/(begin-end);
+    flex_t across=door->axis ? a.x+t*(b.x-a.x) : a.y+t*(b.y-a.y);
+    flex_t z=a.z+t*(b.z-a.z);
+    return across>=door->acrossMin && across<=door->acrossMax && z>=door->zMin && z<=door->zMax;
+}
