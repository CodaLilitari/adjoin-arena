+static int Bot_C3StockFile(const char *path, int length, const char *digest)
+{
+    stdFile_t file=std_g_pHS->fileOpen(path,"rb");
+    if (!file) return 0;
+    int verified=0;
+    if (std_g_pHS->fileSize(file)==length) {
+        void *data=malloc((size_t)length);
+        if (data && std_g_pHS->fileRead(file,data,(size_t)length)==(size_t)length) {
+            char actual[65];
+            jkBotBrain_Sha256Hex(data,(size_t)length,actual);
+            verified=!strcmp(digest,actual);
+        }
+        free(data);
+    }
+    std_g_pHS->fileClose(file);
+    return verified;
+}
+
+static int Bot_C3OpeningFor(SithThing *door, BotC3Opening *opening)
+{
+    if (!door || door->moveType!=SITH_MT_PATH || door->trackParams.loadedFrames!=2 ||
+        !door->trackParams.aFrames) return 0;
+    rdVector3 closed=door->trackParams.aFrames[0].pos;
+    SithSector *sector=Bot_SectorAt(&closed,door->sector);
+    if (!sector) return 0;
+    rdVector3 low={1e20f,1e20f,1e20f}, high={-1e20f,-1e20f,-1e20f};
+    int faces=0;
+    for (unsigned int i=0;i<sector->numSurfaces;++i) {
+        SithSurface *surface=&sector->surfaces[i];
+        if (!surface->pAdjoin) continue;
+        rdFace *face=&surface->surfaceInfo.face;
+        if (face->numVertices<3 || !face->vertexPosIdx) return 0;
+        ++faces;
+        for (unsigned j=0;j<face->numVertices;++j) {
+            int v=face->vertexPosIdx[j];
+            if (v<0 || v>=bot.world->numVertices) return 0;
+            rdVector3 p=bot.world->aVertices[v];
+            low.x=fminf(low.x,p.x); low.y=fminf(low.y,p.y); low.z=fminf(low.z,p.z);
+            high.x=fmaxf(high.x,p.x); high.y=fmaxf(high.y,p.y); high.z=fmaxf(high.z,p.z);
+        }
+    }
+    if (faces!=2) return 0;
+    int axis=(high.y-low.y < high.x-low.x);
+    flex_t thickness=axis ? high.y-low.y : high.x-low.x;
+    if (thickness<=0 || thickness>.06f || high.z-low.z<.15f) return 0;
+    *opening=(BotC3Opening){axis, axis ? (low.y+high.y)*.5f : (low.x+high.x)*.5f,
+        axis ? low.x : low.y, axis ? high.x : high.y, low.z, high.z};
+    return 1;
+}
