+static void Bot_C3ReadDoors(void)
+{
+    memset(&c3Access,0,sizeof(c3Access));
+    c3Access.lastDenied=-1;
+#ifdef SITH_DEBUG_STRUCT_NAMES
+    if (!nav.ctf || !Bot_NameIs(bot.world->map_jkl_fname,"c3.jkl")) return;
+    /* A replacement with the same filename or edited scripts keeps ordinary routing. */
+    if (!Bot_C3StockFile("jkl\\c3.jkl",3313579,"b4d804591cebebbd59f05ad42a8e059178dc468e24172bd6bc5b7d6ba1c2f0a7") ||
+        !Bot_C3StockFile("cog\\ctf_doorred.cog",1614,"06ddfe25a196f1b3186ff18dab328b04924ea19eaf6d444d9c79efa4834f7d2b") ||
+        !Bot_C3StockFile("cog\\ctf_doorgold.cog",1618,"cdba0dce328ba7a88e15eef79716886f882cd676a84d738444b3151034382338") ||
+        !Bot_C3StockFile("cog\\c3_sascolored.cog",4414,"58f163a3b26e9f7103b06983b93fcecd9fc4a0215d1c8953f7e75bdfc9053bed")) return;
+    for (int i=0;i<bot.world->numCogs && c3Access.count<6;++i) {
+        sithCog *cog=&bot.world->aCogs[i];
+        if (!cog->pScript) continue;
+        const char *script=cog->pScript->aName;
+        int paired=Bot_NameIs(script,"c3_sascolored.cog");
+        int bin=Bot_C3ScriptBin(script,paired ? Bot_CogReference(cog,"sas_color") : 0);
+        if (!bin) continue;
+        int index=Bot_CogReference(cog,paired ? "door_int" : "door");
+        SithThing *thing=Bot_NavThing(index);
+        BotC3Door *door=&c3Access.doors[c3Access.count];
+        if (!Bot_C3OpeningFor(thing,&door->opening)) continue;
+        door->thing=index; door->signature=thing->signature; door->bin=bin; door->paired=paired;
+        ++c3Access.count;
+    }
+    fprintf(stderr,"BOT_C3_ACCESS name=%s event=bind doors=%d\n",bot.name,c3Access.count);
+    if (c3Access.count!=6) c3Access.count=0;
+#endif
+}
+
+static unsigned Bot_C3DeniedMask(SithThing *self)
+{
+    if (!c3Access.count) return 0;
+    flex_t red=sithInventory_GetInventory(self,83), gold=sithInventory_GetInventory(self,84);
+    unsigned blocked=0;
+    for (int i=0;i<c3Access.count;++i) {
+        BotC3Door *door=&c3Access.doors[i];
+        SithThing *thing=Bot_NavThing(door->thing);
+        if (!thing || thing->signature!=door->signature) continue;
+        int open=thing->curframe==1 && !(thing->trackParams.flags&3);
+        if (Bot_C3Denied(door->bin,door->paired,door->bin==83 ? red : gold,open)) blocked|=1u<<i;
+    }
+    if ((int)blocked!=c3Access.lastDenied) {
+        fprintf(stderr,"BOT_C3_ACCESS name=%s event=access blocked=%u red=%.1f gold=%.1f\n",
+                bot.name,blocked,(double)red,(double)gold);
+        c3Access.lastDenied=(int)blocked;
+    }
+    return blocked;
+}
+
+static unsigned Bot_C3CrossingMask(rdVector3 a, rdVector3 b)
+{
+    unsigned mask=0;
+    for (int i=0;i<c3Access.count;++i)
+        if (Bot_C3Crosses(&c3Access.doors[i].opening,a,b)) mask|=1u<<i;
+    return mask;
+}
