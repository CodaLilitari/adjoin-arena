     wsrelay_bListForget = 1;
 }
 
+int stdComm_WSRelay_BotRoomId(int idx)
+{
+    return idx >= 0 && idx < wsrelay_numShown ? wsrelay_aShownRooms[idx] : 0;
+}
+
+// This launcher mounts the operator's episode. Mod and asset-pack transfers
+// require the stock site's mod manager.
+int stdComm_WSRelay_BotBaseGame(int idx, int welcomed)
+{
+    /* PR4 (Wren): a bot started with the same -path mod as the host
+       (JK_BOT_WEB_MOD=1, the launcher's --model-gob) may join a room whose
+       lobby tail names a mod; the ordinary mods.js check after the welcome
+       (wsrelay_GetHostMod) still finds the bot already on the host's mod, or
+       restarts it like any player. Without it, a modded room stays refused. */
+    const char *withMod=getenv("JK_BOT_WEB_MOD");
+    int modOk=withMod && !strcmp(withMod,"1");
+    if (!stdComm_WSRelay_BotRoomId(idx) || (wsrelay_aShownTails[idx][0] && !modOk)) return 0;
+    if (!welcomed) return 1;
+    const jkMultiEntry *listed=&jkGuiMultiplayer_aEntries[idx], *actual=&wsrelay_storedEntryEnum;
+    return wsrelay_room==wsrelay_aShownRooms[idx] && (modOk || !wsrelay_storedTailEnum[0]) &&
+           !__strcmpi(listed->episodeGobName,actual->episodeGobName) &&
+           !__strcmpi(listed->mapJklFname,actual->mapJklFname) &&
+           listed->maxRank==actual->maxRank && listed->multiModeFlags==actual->multiModeFlags &&
+           listed->tickRateMs==actual->tickRateMs && !(actual->sessionFlags & SESSIONFLAG_PASSWORD);
+}
