+/* Observe only the actual legal directed leg the bot was following. */
+static unsigned long long Bot_BrainNodeKey(const BotNode *n)
+{
+    unsigned long long key=14695981039346656037ULL;
+    const int coords[]={n->sector ? (int)n->sector->id : -1, (int)llround(n->pos.x*65536.0),
+                        (int)llround(n->pos.y*65536.0), (int)llround(n->pos.z*65536.0)};
+    for (int i=0;i<4;i++) { key^=(unsigned)coords[i]; key*=1099511628211ULL; }
+    return key;
+}
+
+static void Bot_BrainObserve(int node,int failed)
+{
+    if (!botBrain.observe || !bot.followingRoute || bot.routePos<0 || bot.routePos>=bot.routeCount ||
+        node<0 || node>=bot.nNodes || bot.route[bot.routePos]!=node) return;
+    int from=bot.routePos ? bot.route[bot.routePos-1] : botBrain.start;
+    if (from<0 || from==node || from>=bot.nNodes) return;
+    BotNode *a=&bot.nodes[from],*b=&bot.nodes[node];
+    for (int i=0;i<a->nEdges;i++) if (a->edges[i].to==node) {
+        fprintf(stderr,"BOT_EDGE_ATTEMPT name=%s t=%.3f event=%s from_key=%llx to_key=%llx edge=%d dist_mm=%lld dz_mm=%lld from_water=%d to_water=%d dest_item=%d base_cost_milli=%lld degree_from=%d degree_to=%d\n",
+                bot.name,(double)bot.now,failed?"stall":"arrive",Bot_BrainNodeKey(a),Bot_BrainNodeKey(b),
+                (int)a->edges[i].drop,Bot_BrainMilli(Bot_Distance(a->pos,b->pos)),Bot_BrainMilli(b->pos.z-a->pos.z),
+                !!(a->sector && (a->sector->flags&SITH_SECTOR_UNDERWATER)),
+                !!(b->sector && (b->sector->flags&SITH_SECTOR_UNDERWATER)),b->item>=0,
+                Bot_BrainMilli(a->edges[i].cost),a->nEdges,b->nEdges);
+        break;
+    }
+}
