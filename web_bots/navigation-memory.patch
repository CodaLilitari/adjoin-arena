+/* Without a reachable graph leg, move on Red's collision-checked floor.
+ * Objective headings are retained, including the stock CTF lobby objective. */
+static int Bot_ExploreUnrouted(SithThing *self)
+{
+    if (bot.nextRecovery>0 || nav.seekingSurface ||
+        !(self->attach_flags & (SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE)) ||
+        self->sector->flags&SITH_SECTOR_UNDERWATER || Bot_NavigationWaiting(self)) return 0;
+    rdVector3 desired=self->orient.lvec;
+    if (nav.objectiveValid) desired=Bot_Sub(nav.objectivePos,self->position);
+    else if (nav.ctf || nav.objective==BOT_OBJECTIVE_AIR) return 0;
+    if (Bot_Horizontal(desired)<0.12f) return 0;
+    static const flex_t angles[]={0,0.45f,-0.45f,0.95f,-0.95f};
+    for (int i=0;i<5;++i) {
+        flex_t a=angles[i]; rdVector3 blocked;
+        rdVector3 dir={desired.x*cosf(a)-desired.y*sinf(a),desired.x*sinf(a)+desired.y*cosf(a),0};
+        if (!Bot_SafeDirection(self,dir,0,0.30f,&blocked)) continue;
+        rdVector3 aim={self->position.x+dir.x,self->position.y+dir.y,self->position.z};
+        Bot_Aim(self,aim,0); Bot_Move(self,dir,0);
+        return 1;
+    }
+    return 0;
+}
